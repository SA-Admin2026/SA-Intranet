###  http://www.semanticarts.com/vocab/_Concept_SemanticAnnotationsforWebServicesDescriptionLanguage
<http://www.semanticarts.com/vocab/_Concept_SemanticAnnotationsforWebServicesDescriptionLanguage> rdf:type owl:NamedIndividual ,
                                                                                                           skos:Concept ;
                                                                                                  skos:definition "Standard for adding semantic description of Web service capability as annotation in the WSDL interface definition. (Previously, WSDL-S)" ;
                                                                                                  skos:prefLabel "Semantic Annotations for Web Services Description Language" .


###  http://www.semanticarts.com/vocab/_Concept_SemanticWeb
<http://www.semanticarts.com/vocab/_Concept_SemanticWeb> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:altLabel "Web 3.0" ;
                                                         skos:definition "Next generation  Internet where all the content is tagged with semantic tags and committed to ontologies. An interlinking of ontologies will allow agents to reason about information only tangentially connected (and not previously connected by their creators)." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_SemanticWeb> ,
                                                                       <http://www.semanticarts.com/vocab/_Domain_network> ;
                                                         skos:prefLabel "Semantic Web" .


###  http://www.semanticarts.com/vocab/_Concept_SemanticsinBusinessVocabularyandBusinessRules
<http://www.semanticarts.com/vocab/_Concept_SemanticsinBusinessVocabularyandBusinessRules> rdf:type owl:NamedIndividual ,
                                                                                                    skos:Concept ;
                                                                                           skos:definition "A meta model and standard vocabulary for specifying business rules." ;
                                                                                           skos:hiddenLabel "SBVR" ;
                                                                                           skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standard> ;
                                                                                           skos:prefLabel "Semantics in Business Vocabulary and Business Rules" .


###  http://www.semanticarts.com/vocab/_Concept_SimpleKnowledgeOrganizationSystem
<http://www.semanticarts.com/vocab/_Concept_SimpleKnowledgeOrganizationSystem> rdf:type owl:NamedIndividual ,
                                                                                        skos:Concept ;
                                                                               skos:definition "A standard for describing knowledge structures such as taxonomies and thesauri." ;
                                                                               skos:hiddenLabel "SKOS" ;
                                                                               skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards,semanticweb> ;
                                                                               skos:prefLabel "Simple Knowledge Organization System" .


