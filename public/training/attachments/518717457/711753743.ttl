                                                   skos:hiddenLabel "TARQL" ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards;SemanticWeb> ;
                                                   skos:prefLabel "TARQL" .


###  http://www.semanticarts.com/vocab/_Concept_TimBerners-Lee
<http://www.semanticarts.com/vocab/_Concept_TimBerners-Lee> rdf:type owl:NamedIndividual ,
                                                                     skos:Concept ;
                                                            skos:definition "WWW inventor; often goes by his initials." ;
                                                            skos:hiddenLabel "TBL" ;
                                                            skos:prefLabel "Tim Berners-Lee" .


###  http://www.semanticarts.com/vocab/_Concept_WSDL
<http://www.semanticarts.com/vocab/_Concept_WSDL> rdf:type owl:NamedIndividual ,
                                                           skos:Concept ;
                                                  skos:definition "Standard for defining the interface to a Web service, expressed as an XSD dialect. Pronounced \"whizdull.\"" ;
                                                  skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards> ;
                                                  skos:prefLabel "WSDL" .


###  http://www.semanticarts.com/vocab/_Concept_WSDLS
<http://www.semanticarts.com/vocab/_Concept_WSDLS> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_SOA> ;
                                                   skos:prefLabel "WSDL/S" ;
                                                   skos:related "See SAWSDL." .


###  http://www.semanticarts.com/vocab/_Concept_Web2.0
<http://www.semanticarts.com/vocab/_Concept_Web2.0> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ;
                                                    skos:definition "Web based capability characterized by collaboration and user-created content, including blogs and wikis." ;
                                                    skos:prefLabel "Web 2.0" .


###  http://www.semanticarts.com/vocab/_Concept_Webontologylanguage
<http://www.semanticarts.com/vocab/_Concept_Webontologylanguage> rdf:type owl:NamedIndividual ,
                                                                          skos:Concept ;
                                                                 skos:definition "Successor to DAML + OIL a W3C standard." ;
                                                                 skos:hiddenLabel "OWL" ;
                                                                 skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards> ;
                                                                 skos:note "The origin of the dyslexic acronym is attributed to the owl in Winnie the Pooh who spelled his name \"WOL.\"" ;
                                                                 skos:prefLabel "Web ontology language" .


###  http://www.semanticarts.com/vocab/_Concept_Webservices
<http://www.semanticarts.com/vocab/_Concept_Webservices> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "RPC in which the request is in XML. Allows caller and receiver to be in different technologies as long as each can queue the message and process the XML request or response." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_architecture> ;
                                                         skos:prefLabel "Web services" .


###  http://www.semanticarts.com/vocab/_Concept_WordNet
<http://www.semanticarts.com/vocab/_Concept_WordNet> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Open source dictionary of the English language. Built as a searchable graph with disambiguation of word senses and thesaurus-style linking of similar word senses. Many of the concepts have hypernymy, polysymy, and mereologic links." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_ontology> ;
                                                     skos:prefLabel "WordNet" .


###  http://www.semanticarts.com/vocab/_Concept_WorldWideWeb
<http://www.semanticarts.com/vocab/_Concept_WorldWideWeb> rdf:type owl:NamedIndividual ,
                                                                   skos:Concept ;
                                                          skos:definition "The layer on top of the Internet that most people now think of as the Internet. Includes Web servers that are reachable by URLs and DNS, that accept HTTP reuqests on port 80 and that serve up user Interfaces in HTML." ;
                                                          skos:hiddenLabel "WWW" ;
                                                          skos:prefLabel "World Wide Web" .


###  http://www.semanticarts.com/vocab/_Concept_WorldWideWebConsortium
<http://www.semanticarts.com/vocab/_Concept_WorldWideWebConsortium> rdf:type owl:NamedIndividual ,
                                                                             skos:Concept ;
                                                                    skos:definition "Non profit organization responsible for maintaining the standards upon which the World Wide Web is based." ;
                                                                    skos:hiddenLabel "W3C" ;
                                                                    skos:prefLabel "World Wide Web Consortium" .


###  http://www.semanticarts.com/vocab/_Concept_XMI
<http://www.semanticarts.com/vocab/_Concept_XMI> rdf:type owl:NamedIndividual ,
                                                          skos:Concept ;
                                                 skos:definition "Standard for interchanging metadata." ;
                                                 skos:inScheme <http://www.semanticarts.com/vocab/_Domain_XML> ;
                                                 skos:prefLabel "XMI" .


###  http://www.semanticarts.com/vocab/_Concept_XMLschema
<http://www.semanticarts.com/vocab/_Concept_XMLschema> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "Schema language for XML, expressed in XML (as opposed to DTD, which was not in XML)." ;
                                                       skos:hiddenLabel "XSD" ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_XML> ;
                                                       skos:prefLabel "XML schema" .


###  http://www.semanticarts.com/vocab/_Concept_XMLstylesheetlanguage
<http://www.semanticarts.com/vocab/_Concept_XMLstylesheetlanguage> rdf:type owl:NamedIndividual ,
                                                                            skos:Concept ;
                                                                   skos:definition "Declarative language creating a style sheet for XML documents." ;
                                                                   skos:hiddenLabel "XSL" ;
                                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_XML> ;
                                                                   skos:prefLabel "XML style sheet language" .


###  http://www.semanticarts.com/vocab/_Concept_XPath
<http://www.semanticarts.com/vocab/_Concept_XPath> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "Declarative way to define a subset of an XML document that you are interested in. Robust in regard to many structural changes to the document." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_XML> ;
                                                   skos:prefLabel "XPath" .


###  http://www.semanticarts.com/vocab/_Concept_XQuery
<http://www.semanticarts.com/vocab/_Concept_XQuery> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ;
                                                    skos:definition "Query language for retrieving data from an XML document or XML database." ;
                                                    skos:inScheme <http://www.semanticarts.com/vocab/_Domain_XML> ;
                                                    skos:prefLabel "XQuery" .


###  http://www.semanticarts.com/vocab/_Concept_abductivereasoning
<http://www.semanticarts.com/vocab/_Concept_abductivereasoning> rdf:type owl:NamedIndividual ,
                                                                         skos:Concept ;
                                                                skos:definition "A form of logical inference in which a hypothesis is created about the probable causes from observed patterns. " ;
                                                                skos:example "Data mining is essentially an abductive process." ;
                                                                skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                                skos:note "Abductive reasoning is the primary source of new knowledge." ;
                                                                skos:prefLabel "abductive reasoning" ;
                                                                skos:related "induction; deduction" .


###  http://www.semanticarts.com/vocab/_Concept_abstract
<http://www.semanticarts.com/vocab/_Concept_abstract> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "A more generalized representation." ;
                                                      skos:example "\"Animal\" is a more abstract concept than \"bear.\"" ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                      skos:prefLabel "abstract" .


###  http://www.semanticarts.com/vocab/_Concept_accretion
<http://www.semanticarts.com/vocab/_Concept_accretion> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "The process of gradual change, which is typically accommodated by a system structure. " ;
                                                       skos:example "In nature, the depositing of silt on a river bend is an accretive change. Overflowing the bank and creating a new channel is an avulsive change." ;
                                                       skos:prefLabel "accretion" ;
                                                       skos:related "avulsion" .


###  http://www.semanticarts.com/vocab/_Concept_acyclic
<http://www.semanticarts.com/vocab/_Concept_acyclic> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Not cyclic; does not loop recursively. " ;
                                                     skos:example "If you were one of your own ancestors, you would have a cyclic family tree." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling;graphtheory> ;
                                                     skos:prefLabel "acyclic" .


###  http://www.semanticarts.com/vocab/_Concept_agent
<http://www.semanticarts.com/vocab/_Concept_agent> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   <http://www.co-ode.org/ontologies/ont.owl#hasDomain> <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                   skos:definition "An autonomous software program acting on a user’s behalf." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                   skos:prefLabel "agent" .


###  http://www.semanticarts.com/vocab/_Concept_aggregate
<http://www.semanticarts.com/vocab/_Concept_aggregate> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "A type of relationship that implies ownership." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_UnifiedModelingLangage,Entity-RelationshipModeling> ;
                                                       skos:note "Aggregate relationships are used in the Unified Modeling Language (UML) and entity-relationship (ER) diagrams." ;
                                                       skos:prefLabel "aggregate" .


###  http://www.semanticarts.com/vocab/_Concept_alias
<http://www.semanticarts.com/vocab/_Concept_alias> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   <http://www.co-ode.org/ontologies/ont.owl#hasDomain> <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                   skos:altLabel "synonym" ;
                                                   skos:definition "An alternative and usually easier-to-understand name for a defined data object. " ,
                                                                   "An alternative name for something." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_computerscience> ,
                                                                 <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                   skos:prefLabel "alias" .


###  http://www.semanticarts.com/vocab/_Concept_ambiguity
<http://www.semanticarts.com/vocab/_Concept_ambiguity> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:altLabel "uncertainty" ;
                                                       skos:definition "A definition or identification that can be understood in more than one way." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                       skos:note "Ambiguity leaves uncertainty as to the specific assignment of referent to thing." ;
                                                       skos:prefLabel "ambiguity" .


###  http://www.semanticarts.com/vocab/_Concept_annotation
<http://www.semanticarts.com/vocab/_Concept_annotation> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "A property that is not interpreted by the inference engine. " ,
                                                                        "The addition of qualifying or contextual information to text or an interface description." ;
                                                        skos:example "Annotations can include comments plus a large number of other properties that could be interpreted by other processors." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_OWL> ,
                                                                      <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                        skos:prefLabel "annotation " .


###  http://www.semanticarts.com/vocab/_Concept_antonymy
<http://www.semanticarts.com/vocab/_Concept_antonymy> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:altLabel "opposite, antonym" ;
                                                      skos:definition "A sense relation between two words with opposite meanings. " ;
                                                      skos:example "\"Light\" and \"dark,\" \"dead\" and \"alive,\" \"slow\" and \"quick\" are pairs of antonyms." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                      skos:prefLabel "antonymy" .


###  http://www.semanticarts.com/vocab/_Concept_assertion
<http://www.semanticarts.com/vocab/_Concept_assertion> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "A statement that asserts that a certain premise is true." ;
                                                       skos:example "\"Robert Jones is Employee 1234\" or \"the Earth is round\" are assertions." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic;modeling> ;
                                                       skos:prefLabel "assertion" .


###  http://www.semanticarts.com/vocab/_Concept_assertionalbox
<http://www.semanticarts.com/vocab/_Concept_assertionalbox> rdf:type owl:NamedIndividual ,
                                                                     skos:Concept ;
                                                            skos:altLabel "a-box" ;
                                                            skos:definition "Inferences on instances (assertions). " ;
                                                            skos:example "Essentially reasoning on instances, similar to the way SQL reasons over instances in a database. Also, extensional." ;
                                                            skos:hiddenLabel "ABox" ;
                                                            skos:inScheme <http://www.semanticarts.com/vocab/_Domain_OWL,descriptionlogic> ;
                                                            skos:note """TBox statements are sometimes associated with object-oriented classes and ABox statements associated with instances of those classes.
""" ;
                                                            skos:prefLabel "assertional box" ;
                                                            skos:related "Tbox, Cbox" .


###  http://www.semanticarts.com/vocab/_Concept_association
<http://www.semanticarts.com/vocab/_Concept_association> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "A type of relationship that does not imply ownership." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_UnifiedModelingLangage,Entity-RelationshipModeling> ;
                                                         skos:prefLabel "association" .


###  http://www.semanticarts.com/vocab/_Concept_associativedatabase
<http://www.semanticarts.com/vocab/_Concept_associativedatabase> rdf:type owl:NamedIndividual ,
                                                                          skos:Concept ;
                                                                 <http://www.co-ode.org/ontologies/ont.owl#hasDomain> <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                                 skos:definition "A style of database design, using sentences to describe associations." ;
                                                                 skos:inScheme <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                                 skos:prefLabel "associative database" .


###  http://www.semanticarts.com/vocab/_Concept_asynchronousmessaging
<http://www.semanticarts.com/vocab/_Concept_asynchronousmessaging> rdf:type owl:NamedIndividual ,
                                                                            skos:Concept ;
                                                                   <http://www.co-ode.org/ontologies/ont.owl#hasDomain> <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                                   skos:definition "Message transmissions without a “block and wait” for response." ;
                                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                                   skos:prefLabel "asynchronous messaging" .


###  http://www.semanticarts.com/vocab/_Concept_attribute
<http://www.semanticarts.com/vocab/_Concept_attribute> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:altLabel "property, characteristic" ;
                                                       skos:definition "A property or characteristic of an entity." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                       skos:note "An attribute is not a property in terms of a relationship expressed in RDF. In other words, an attribute does not connects two concepts." ;
                                                       skos:prefLabel "attribute" .


###  http://www.semanticarts.com/vocab/_Concept_avulsion
<http://www.semanticarts.com/vocab/_Concept_avulsion> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Rapid, discontinuous change; a change to a data structure that breaks dependent modules." ;
                                                      skos:example "In nature, the depositing of silt on a river bend is an accretive change. Overflowing the bank and creating a new channel is an evulsive change." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                      skos:prefLabel "avulsion" ;
                                                      skos:related "accretion" .


###  http://www.semanticarts.com/vocab/_Concept_axiom
<http://www.semanticarts.com/vocab/_Concept_axiom> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:altLabel "postulate" ;
                                                   skos:definition "A statement of self-evident truth used as a starting point for reasoning." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                   skos:prefLabel "axiom" .


###  http://www.semanticarts.com/vocab/_Concept_behavior
<http://www.semanticarts.com/vocab/_Concept_behavior> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "The methods that execute code." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_object-orientedsoftware> ;
                                                      skos:prefLabel "behavior" .


###  http://www.semanticarts.com/vocab/_Concept_binary
<http://www.semanticarts.com/vocab/_Concept_binary> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ;
                                                    skos:definition "A relationship with an inverse." ;
                                                    skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                    skos:prefLabel "binary" .


###  http://www.semanticarts.com/vocab/_Concept_bind
<http://www.semanticarts.com/vocab/_Concept_bind> rdf:type owl:NamedIndividual ,
                                                           skos:Concept ;
                                                  skos:definition "Attaching a request to an implementation. Implementations are in specific technologies, and to invoke them one has to attach an often abstract description of a request to the specific module that will invoke it. Adaptors bind to applications." ;
                                                  skos:prefLabel "bind" .


###  http://www.semanticarts.com/vocab/_Concept_canonical
<http://www.semanticarts.com/vocab/_Concept_canonical> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       <http://www.co-ode.org/ontologies/ont.owl#hasDomain> <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                       skos:altLabel "canonicality, canonicity" ;
                                                       skos:definition "An accepted standard. " ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                       skos:note "In message modeling, declaring something \"canonical\" is the process of declaring a standard for message content rather than allowing each project to define its own." ;
                                                       skos:prefLabel "canonical" .


###  http://www.semanticarts.com/vocab/_Concept_cardinality
<http://www.semanticarts.com/vocab/_Concept_cardinality> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "A constraint on the number of successors on a relationship. " ,
                                                                         "A type of class restriction that limits the members of a class to those with the requisite number of unique property assertions." ;
                                                         skos:example "The cardinality for the relationship \"biological mother\" is 1; for \"biological child\" it is 0 or greater." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_descriptionlogic> ,
                                                                       <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                         skos:prefLabel "cardinality" .


###  http://www.semanticarts.com/vocab/_Concept_categoricalbox
<http://www.semanticarts.com/vocab/_Concept_categoricalbox> rdf:type owl:NamedIndividual ,
                                                                     skos:Concept ;
                                                            skos:altLabel "c-box" ;
                                                            skos:hiddenLabel "Cbox" ;
                                                            skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                            skos:prefLabel "categorical box" .


###  http://www.semanticarts.com/vocab/_Concept_categorization
<http://www.semanticarts.com/vocab/_Concept_categorization> rdf:type owl:NamedIndividual ,
                                                                     skos:Concept ;
                                                            skos:definition "The act of ascribing an instance to a knowledge-level group for the purpose of inferring additional information about the instance." ;
                                                            skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                            skos:prefLabel "categorization" .


###  http://www.semanticarts.com/vocab/_Concept_causation
<http://www.semanticarts.com/vocab/_Concept_causation> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "A relationship with teleologic attribute." ;
                                                       skos:example "Travel causes displacement." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                       skos:prefLabel "causation" .


###  http://www.semanticarts.com/vocab/_Concept_characterdata
<http://www.semanticarts.com/vocab/_Concept_characterdata> rdf:type owl:NamedIndividual ,
                                                                    skos:Concept ;
                                                           skos:definition "Character data that is ignored by a parser." ;
                                                           skos:hiddenLabel "CDATA" ;
                                                           skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards,XML> ;
                                                           skos:prefLabel "character data" ;
                                                           skos:related "parsed character data" .


###  http://www.semanticarts.com/vocab/_Concept_class
<http://www.semanticarts.com/vocab/_Concept_class> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "A definition of attributes and behaviors for a type of instance; the basic module for object-oriented programming. " ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_object-orientedprogramming> ;
                                                   skos:note "In object-oriented programming, \"class\" and \"type\" are nearly synonymous, but the slight difference causes considerable problems." ;
                                                   skos:prefLabel "class" .


###  http://www.semanticarts.com/vocab/_Concept_co-occurrenceanalysis
<http://www.semanticarts.com/vocab/_Concept_co-occurrenceanalysis> rdf:type owl:NamedIndividual ,
                                                                            skos:Concept ;
                                                                   skos:definition "Using contiguousness as a clue for evaluating the relatedness of things." ;
                                                                   skos:example "If two terms typically show up near each other in text, they are likely related." ;
                                                                   skos:prefLabel "co-occurrence analysis" .


###  http://www.semanticarts.com/vocab/_Concept_cohesion
<http://www.semanticarts.com/vocab/_Concept_cohesion> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      <http://www.co-ode.org/ontologies/ont.owl#hasDomain> <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                      skos:definition "The degree to which the elements inside a module belong together." ;
                                                      skos:example "In a cohesive module, all the parts are closely related; there are no extraneous parts." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_computerscience> ;
                                                      skos:prefLabel "cohesion" .


###  http://www.semanticarts.com/vocab/_Concept_column
<http://www.semanticarts.com/vocab/_Concept_column> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ;
                                                    skos:definition "An attribute for relational databases." ;
                                                    skos:inScheme <http://www.semanticarts.com/vocab/_Domain_databases> ;
                                                    skos:prefLabel "column" .


###  http://www.semanticarts.com/vocab/_Concept_commitmenttoontology
<http://www.semanticarts.com/vocab/_Concept_commitmenttoontology> rdf:type owl:NamedIndividual ,
                                                                           skos:Concept ;
                                                                  skos:definition "Declaration that a domain or document makes in terms of using and agreeing with the meaning of terms from a particular ontology. " ;
                                                                  skos:inScheme <http://www.semanticarts.com/vocab/_Domain_SemanticWeb> ;
                                                                  skos:note "The commitment to ontology is the key to different documents being able to intercommunicate." ;
                                                                  skos:prefLabel "commitment to ontology" .


###  http://www.semanticarts.com/vocab/_Concept_commonlogic
<http://www.semanticarts.com/vocab/_Concept_commonlogic> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "Framework for a set of knowledge representation standards." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards> ;
                                                         skos:prefLabel "common logic" .


###  http://www.semanticarts.com/vocab/_Concept_competencyquestion
<http://www.semanticarts.com/vocab/_Concept_competencyquestion> rdf:type owl:NamedIndividual ,
                                                                         skos:Concept ;
                                                                skos:definition "A question that defines the objective, scope and expressiveness requirements for an ontology." ;
                                                                skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                                skos:prefLabel "competency question" .


###  http://www.semanticarts.com/vocab/_Concept_complete
<http://www.semanticarts.com/vocab/_Concept_complete> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "A class that has necessary and sufficient conditions; a restriction class." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_OWL> ;
                                                      skos:prefLabel "complete" .


###  http://www.semanticarts.com/vocab/_Concept_compound
<http://www.semanticarts.com/vocab/_Concept_compound> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Group of individual words whose meaning can only be known in combination." ;
                                                      skos:example "World Series, the White House" ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                      skos:prefLabel "compound" .


###  http://www.semanticarts.com/vocab/_Concept_conceptualization
<http://www.semanticarts.com/vocab/_Concept_conceptualization> rdf:type owl:NamedIndividual ,
                                                                        skos:Concept ;
                                                               skos:definition "Abstract, simplified view of the world that we wish to represent for some purpose." ;
                                                               skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                               skos:prefLabel "conceptualization" .


###  http://www.semanticarts.com/vocab/_Concept_conceptualmodel
<http://www.semanticarts.com/vocab/_Concept_conceptualmodel> rdf:type owl:NamedIndividual ,
                                                                      skos:Concept ;
                                                             skos:definition "Model independent of implementation." ;
                                                             skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                             skos:prefLabel "conceptual model" .


###  http://www.semanticarts.com/vocab/_Concept_conjunction
<http://www.semanticarts.com/vocab/_Concept_conjunction> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "And." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                         skos:prefLabel "conjunction" .


###  http://www.semanticarts.com/vocab/_Concept_consortium
<http://www.semanticarts.com/vocab/_Concept_consortium> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "An association, typically a group of business companies." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                        skos:prefLabel "consortium" .


###  http://www.semanticarts.com/vocab/_Concept_constraints
<http://www.semanticarts.com/vocab/_Concept_constraints> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "Predicates which must be true or else transactions are not committed." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                         skos:prefLabel "constraints" .


###  http://www.semanticarts.com/vocab/_Concept_content
<http://www.semanticarts.com/vocab/_Concept_content> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Intellectual property. " ;
                                                     skos:example "Documents, messages" ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_data> ;
                                                     skos:prefLabel "content" .


###  http://www.semanticarts.com/vocab/_Concept_controlledvocabulary
<http://www.semanticarts.com/vocab/_Concept_controlledvocabulary> rdf:type owl:NamedIndividual ,
                                                                           skos:Concept ;
                                                                  skos:definition "Pre-defined list of allowable terms with definitions." ;
                                                                  skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                                  skos:prefLabel "controlled vocabulary" .


###  http://www.semanticarts.com/vocab/_Concept_declaredmembership
<http://www.semanticarts.com/vocab/_Concept_declaredmembership> rdf:type owl:NamedIndividual ,
                                                                         skos:Concept ;
                                                                skos:definition "A class where the intention of the designers is to have users declare that instances/individuals are members of the class." ;
                                                                skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics,descriptionlogic,modeling> ;
                                                                skos:prefLabel "declared membership" ;
                                                                skos:related "derived membership" .


###  http://www.semanticarts.com/vocab/_Concept_deduction
<http://www.semanticarts.com/vocab/_Concept_deduction> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "To infer knowledge of an instance from its membership in a category or type. The process of using knowledge but not of creating it." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                       skos:prefLabel "deduction" .


###  http://www.semanticarts.com/vocab/_Concept_definition
<http://www.semanticarts.com/vocab/_Concept_definition> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "A description of what something means." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                        skos:note "Definitions are often sufficient for humans, rarely sufficient for software agents." ;
                                                        skos:prefLabel "definition" .


###  http://www.semanticarts.com/vocab/_Concept_delimiters
<http://www.semanticarts.com/vocab/_Concept_delimiters> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Separators in a message that allow a parser to know where one element starts and ends." ;
                                                        skos:prefLabel "delimiters" .


###  http://www.semanticarts.com/vocab/_Concept_dependency
<http://www.semanticarts.com/vocab/_Concept_dependency> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Recognition that one software component will be adversely affected if another one changes. Most software has dependencies on its operating system, but will also have dependencies of an often deep stack of other software components." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_softwaredesign,modeling> ;
                                                        skos:prefLabel "dependency" .


###  http://www.semanticarts.com/vocab/_Concept_derivedmembership
<http://www.semanticarts.com/vocab/_Concept_derivedmembership> rdf:type owl:NamedIndividual ,
                                                                        skos:Concept ;
                                                               skos:definition "A class where the intention of the designers is to have instances/individuals be assigned membership by a reasoning engine." ;
                                                               skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                               skos:prefLabel "derived membership" .


###  http://www.semanticarts.com/vocab/_Concept_descriptionlogic
<http://www.semanticarts.com/vocab/_Concept_descriptionlogic> rdf:type owl:NamedIndividual ,
                                                                       skos:Concept ;
                                                              skos:definition "A form of formal logic that focuses on inference, which as been adopted by the Semantic Web in the form of OWL/DL." ,
                                                                              "A specialization in computer science that uses formal language to define classes. " ;
                                                              skos:example "OWL/DL is a standard for describing Description Logic." ;
                                                              skos:hiddenLabel "DL" ;
                                                              skos:inScheme <http://www.semanticarts.com/vocab/_Domain_descriptionlogics> ,
                                                                            <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                              skos:prefLabel "description logic" .


###  http://www.semanticarts.com/vocab/_Concept_designtime
<http://www.semanticarts.com/vocab/_Concept_designtime> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Refers to things that need to be changed when the software is being designed (or modified). For example, a scheduling algorithm is normally a design-time choice. However, it is possible to design an architecture in which the algorithm is a run-time option that could be selected by a user or another software component." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_softwaredesign> ;
                                                        skos:prefLabel "design time" .


###  http://www.semanticarts.com/vocab/_Concept_dialect
<http://www.semanticarts.com/vocab/_Concept_dialect> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "A subset of a language agreed to by a group of people." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_linguistics> ;
                                                     skos:prefLabel "dialect" .


###  http://www.semanticarts.com/vocab/_Concept_dictionary
<http://www.semanticarts.com/vocab/_Concept_dictionary> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "A collection of word definitions, with the purpose of distinguishing closely related words. Most dictionaries contain considerable encyclopedia functionality, which obscures their distinction function." ,
                                                                        "Place where metadata for the definition of tables, columns, and so on are stored." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ,
                                                                      <http://www.semanticarts.com/vocab/_Domain_softwaredesign> ;
                                                        skos:prefLabel "dictionary" .


###  http://www.semanticarts.com/vocab/_Concept_dimension
<http://www.semanticarts.com/vocab/_Concept_dimension> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "One of the axes in a data warehouse that can be used to query or summarize the facts in the warehouse." ;
                                                       skos:prefLabel "dimension" .


###  http://www.semanticarts.com/vocab/_Concept_directed
<http://www.semanticarts.com/vocab/_Concept_directed> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "In a network model the property that says whether the arcs have \"arrows.\" A project plan is \"directed\" in that the precedent relationships go in a particular direction. A thesaurus is undirected in that the definitions are only related, without having a direction to them." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                      skos:prefLabel "directed" .


###  http://www.semanticarts.com/vocab/_Concept_directedacylicgraph
<http://www.semanticarts.com/vocab/_Concept_directedacylicgraph> rdf:type owl:NamedIndividual ,
                                                                          skos:Concept ;
                                                                 skos:definition "Graph (network) in which all the nodes are connected and prevented from looping." ;
                                                                 skos:hiddenLabel "DAG" ;
                                                                 skos:inScheme <http://www.semanticarts.com/vocab/_Domain_graphtheory> ;
                                                                 skos:prefLabel "directed acylic graph" .


###  http://www.semanticarts.com/vocab/_Concept_directedgraph
<http://www.semanticarts.com/vocab/_Concept_directedgraph> rdf:type owl:NamedIndividual ,
                                                                    skos:Concept ;
                                                           skos:definition "A graph in which the arcs are directed." ;
                                                           skos:inScheme <http://www.semanticarts.com/vocab/_Domain_graphtheory> ;
                                                           skos:prefLabel "directed graph" .


###  http://www.semanticarts.com/vocab/_Concept_directoryMozilla
<http://www.semanticarts.com/vocab/_Concept_directoryMozilla> rdf:type owl:NamedIndividual ,
                                                                       skos:Concept ;
                                                              skos:definition "Group of volunteers who categorize web sites." ;
                                                              skos:hiddenLabel "DMOZ" ;
                                                              skos:inScheme <http://www.semanticarts.com/vocab/_Domain_directoryMozilla> ;
                                                              skos:prefLabel "directory Mozilla" .


###  http://www.semanticarts.com/vocab/_Concept_disambiguate
<http://www.semanticarts.com/vocab/_Concept_disambiguate> rdf:type owl:NamedIndividual ,
                                                                   skos:Concept ;
                                                          skos:definition "Process of selecting between alternate, ambiguous interpretations. Conversationally, people do this by asking, \"Do you mean x or y?\"" ;
                                                          skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                          skos:prefLabel "disambiguate" .


###  http://www.semanticarts.com/vocab/_Concept_disjoint
<http://www.semanticarts.com/vocab/_Concept_disjoint> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Two classes, sets or individuals can not have overlapping membership. Male and Female are disjoint." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics,descriptionlogic> ;
                                                      skos:prefLabel "disjoint" .


###  http://www.semanticarts.com/vocab/_Concept_disjunction
<http://www.semanticarts.com/vocab/_Concept_disjunction> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "“Or.” The disjunction of two statements is true if either is true." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_descriptionlogic> ;
                                                         skos:prefLabel "disjunction" .


###  http://www.semanticarts.com/vocab/_Concept_distinction
<http://www.semanticarts.com/vocab/_Concept_distinction> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "To set up rules for disambiguating closely related concepts." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_vocabulary> ;
                                                         skos:prefLabel "distinction" .


###  http://www.semanticarts.com/vocab/_Concept_document-typedefinition
<http://www.semanticarts.com/vocab/_Concept_document-typedefinition> rdf:type owl:NamedIndividual ,
                                                                              skos:Concept ;
                                                                     skos:definition "Schema language for SGML, and XML." ;
                                                                     skos:hiddenLabel "DTD" ;
                                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_document-typedefinition> ;
                                                                     skos:prefLabel "document-type definition" .


###  http://www.semanticarts.com/vocab/_Concept_domain
<http://www.semanticarts.com/vocab/_Concept_domain> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ;
                                                    skos:definition "A restriction on the classes that are the subject of a property relationship." ,
                                                                    "The set of valid values of an attribute, i.e., its type. Note: this is very different form the ontology definition of domain below." ;
                                                    skos:inScheme <http://www.semanticarts.com/vocab/_Domain_database> ,
                                                                  <http://www.semanticarts.com/vocab/_Domain_ontology> ;
                                                    skos:prefLabel "domain" .


###  http://www.semanticarts.com/vocab/_Concept_element
<http://www.semanticarts.com/vocab/_Concept_element> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Atomic unit of meaning in XML." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_XML> ;
                                                     skos:prefLabel "element" .


###  http://www.semanticarts.com/vocab/_Concept_encyclopedia
<http://www.semanticarts.com/vocab/_Concept_encyclopedia> rdf:type owl:NamedIndividual ,
                                                                   skos:Concept ;
                                                          skos:definition "A description of what is known about a concept. This is distinct from distinguishing one concept from another, closely related, concept." ;
                                                          skos:inScheme <http://www.semanticarts.com/vocab/_Domain_vocabulary> ;
                                                          skos:prefLabel "encyclopedia" .


###  http://www.semanticarts.com/vocab/_Concept_entailment
<http://www.semanticarts.com/vocab/_Concept_entailment> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Semantic implication within a context, for example buying entails paying." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                        skos:prefLabel "entailment" .


###  http://www.semanticarts.com/vocab/_Concept_enterpriseapplicationintegration
<http://www.semanticarts.com/vocab/_Concept_enterpriseapplicationintegration> rdf:type owl:NamedIndividual ,
                                                                                       skos:Concept ;
                                                                              skos:definition "Industry and products involved in making the interfacing of applications more economical." ;
                                                                              skos:hiddenLabel "EAI" ;
                                                                              skos:inScheme <http://www.semanticarts.com/vocab/_Domain_enterpriseapplicationintegration> ;
                                                                              skos:prefLabel "enterprise application integration" .


###  http://www.semanticarts.com/vocab/_Concept_enterpriseinformationintegration
<http://www.semanticarts.com/vocab/_Concept_enterpriseinformationintegration> rdf:type owl:NamedIndividual ,
                                                                                       skos:Concept ;
                                                                              skos:definition "Architecture where federated queries are used to create an integrated view over many databases." ;
                                                                              skos:hiddenLabel "EII" ;
                                                                              skos:inScheme <http://www.semanticarts.com/vocab/_Domain_enterpriseinformationintegration> ;
                                                                              skos:prefLabel "enterprise information integration" .


###  http://www.semanticarts.com/vocab/_Concept_enterprisemessagemodel
<http://www.semanticarts.com/vocab/_Concept_enterprisemessagemodel> rdf:type owl:NamedIndividual ,
                                                                             skos:Concept ;
                                                                    skos:definition "A set of messages taken in the aggregate that represent the shared information in an organization." ;
                                                                    skos:hiddenLabel "EMM" ;
                                                                    skos:inScheme <http://www.semanticarts.com/vocab/_Domain_enterprisemessagemodel> ;
                                                                    skos:prefLabel "enterprise message model" .


###  http://www.semanticarts.com/vocab/_Concept_entityextraction
<http://www.semanticarts.com/vocab/_Concept_entityextraction> rdf:type owl:NamedIndividual ,
                                                                       skos:Concept ;
                                                              skos:definition "Process of identifying concepts found in documents and tagging them to a predefined ontology." ;
                                                              skos:inScheme <http://www.semanticarts.com/vocab/_Domain_unstructureddata> ;
                                                              skos:prefLabel "entity extraction" .


###  http://www.semanticarts.com/vocab/_Concept_entityrelationship
<http://www.semanticarts.com/vocab/_Concept_entityrelationship> rdf:type owl:NamedIndividual ,
                                                                         skos:Concept ;
                                                                skos:definition "Style of data design focused on the definition of entities and their relationship to each other." ;
                                                                skos:hiddenLabel "ER" ;
                                                                skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                                skos:prefLabel "entity relationship" .


###  http://www.semanticarts.com/vocab/_Concept_epistemology
<http://www.semanticarts.com/vocab/_Concept_epistemology> rdf:type owl:NamedIndividual ,
                                                                   skos:Concept ;
                                                          skos:definition "A branch of philosophy that studies the nature of knowledge." ;
                                                          skos:inScheme <http://www.semanticarts.com/vocab/_Domain_philosophy> ;
                                                          skos:prefLabel "epistemology" .


###  http://www.semanticarts.com/vocab/_Concept_equivalent
<http://www.semanticarts.com/vocab/_Concept_equivalent> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Two representations of the same thing." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                        skos:prefLabel "equivalent" .


###  http://www.semanticarts.com/vocab/_Concept_explicit
<http://www.semanticarts.com/vocab/_Concept_explicit> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "A formal expression of knowledge." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                      skos:prefLabel "explicit" .


###  http://www.semanticarts.com/vocab/_Concept_extensible
<http://www.semanticarts.com/vocab/_Concept_extensible> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Capable of being added to accretively. An extensible data structure is one that additive changes can easily be made. Relational databases are extensible at the table level, in that columns can be added to tables without requiring programs to be rewritten." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_databaseormodel> ;
                                                        skos:prefLabel "extensible" .


###  http://www.semanticarts.com/vocab/_Concept_extensiblestylesheetlanguagetransformation
<http://www.semanticarts.com/vocab/_Concept_extensiblestylesheetlanguagetransformation> rdf:type owl:NamedIndividual ,
                                                                                                 skos:Concept ;
                                                                                        skos:definition "Extension to XSL that includes more structural changes to an XML document." ;
                                                                                        skos:hiddenLabel "XSLT" ;
                                                                                        skos:prefLabel "extensible style sheet language transformation" .


###  http://www.semanticarts.com/vocab/_Concept_extensional
<http://www.semanticarts.com/vocab/_Concept_extensional> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "A set defined by a specific list." ;
                                                         skos:example "The states of the United States is an extensional set." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_model> ;
                                                         skos:prefLabel "extensional" ;
                                                         skos:related "intensional" .


###  http://www.semanticarts.com/vocab/_Concept_extremeprogramming
<http://www.semanticarts.com/vocab/_Concept_extremeprogramming> rdf:type owl:NamedIndividual ,
                                                                         skos:Concept ;
                                                                skos:definition "First of the agile methods, focused on pair programming, test as you go, and refactoring." ;
                                                                skos:hiddenLabel "XP" ;
                                                                skos:prefLabel "extreme programming" .


###  http://www.semanticarts.com/vocab/_Concept_faceted
<http://www.semanticarts.com/vocab/_Concept_faceted> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Having the orthogonally distinct aspects of a taxonomy separated so that each can be dealt with independently." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_taxonomy> ;
                                                     skos:prefLabel "faceted" .


###  http://www.semanticarts.com/vocab/_Concept_firstorderlogic
<http://www.semanticarts.com/vocab/_Concept_firstorderlogic> rdf:type owl:NamedIndividual ,
                                                                      skos:Concept ;
                                                             skos:altLabel "FOL" ;
                                                             skos:definition "A branch of logic dealing with predicate-based reasoning." ;
                                                             skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                             skos:prefLabel "first order logic" .


###  http://www.semanticarts.com/vocab/_Concept_folksonomy
<http://www.semanticarts.com/vocab/_Concept_folksonomy> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "A set of tags made up on the fly by end users to organize a body of work. Almost always a navigational taxonomy. " ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                        skos:prefLabel "folksonomy" ;
                                                        skos:related "navigational" .


###  http://www.semanticarts.com/vocab/_Concept_formal
<http://www.semanticarts.com/vocab/_Concept_formal> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ;
                                                    skos:definition "A taxonomy where all the relationships are “isa” relationships, which can therefore be used in inference." ;
                                                    skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                    skos:prefLabel "formal" .


###  http://www.semanticarts.com/vocab/_Concept_friendofafriend
<http://www.semanticarts.com/vocab/_Concept_friendofafriend> rdf:type owl:NamedIndividual ,
                                                                      skos:Concept ;
                                                             skos:altLabel "FOAF" ;
                                                             skos:definition "An ontology about people and their properties." ;
                                                             skos:prefLabel "friend of a friend" .


###  http://www.semanticarts.com/vocab/_Concept_functional
<http://www.semanticarts.com/vocab/_Concept_functional> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Characteristic of a property which guarantees that there is only a single object. " ;
                                                        skos:example "“BiologicalMother” is a functional property." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_descriptionlogic> ;
                                                        skos:prefLabel "functional" .


###  http://www.semanticarts.com/vocab/_Concept_generalize
<http://www.semanticarts.com/vocab/_Concept_generalize> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "To create a more abstract definition or category." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                        skos:prefLabel "generalize" .


###  http://www.semanticarts.com/vocab/_Concept_gist
<http://www.semanticarts.com/vocab/_Concept_gist> rdf:type owl:NamedIndividual ,
                                                           skos:Concept ;
                                                  skos:definition "A minimal upper ontology." ;
                                                  skos:prefLabel "gist" .


###  http://www.semanticarts.com/vocab/_Concept_glossary
<http://www.semanticarts.com/vocab/_Concept_glossary> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "A list of terms and their definitions." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                      skos:prefLabel "glossary" .


###  http://www.semanticarts.com/vocab/_Concept_grammar
<http://www.semanticarts.com/vocab/_Concept_grammar> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "A set of rules for ordering vocabulary items. In computer science, grammar may be expressed formally." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_linguistics> ;
                                                     skos:prefLabel "grammar" .


###  http://www.semanticarts.com/vocab/_Concept_granularity
<http://www.semanticarts.com/vocab/_Concept_granularity> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "Size of the service. A service with a high level of granularity is referred to as being fine-grained and one with a low-level is coarse-grained." ;
                                                         skos:prefLabel "granularity" .


###  http://www.semanticarts.com/vocab/_Concept_graph
<http://www.semanticarts.com/vocab/_Concept_graph> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "A model of entities (i.e., nodes) connected to relationships (i.e., arcs)." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling,graphtheory> ;
                                                   skos:prefLabel "graph" .


###  http://www.semanticarts.com/vocab/_Concept_grid
<http://www.semanticarts.com/vocab/_Concept_grid> rdf:type owl:NamedIndividual ,
                                                           skos:Concept ;
                                                  skos:definition "A topology where large numbers of processors can contribute to solving one problem." ;
                                                  skos:prefLabel "grid" .


###  http://www.semanticarts.com/vocab/_Concept_grounding
<http://www.semanticarts.com/vocab/_Concept_grounding> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "A connection of implication to empirical data. How we connect pure thought to the real world." ;
                                                       skos:prefLabel "grounding" .


###  http://www.semanticarts.com/vocab/_Concept_hierarchy
<http://www.semanticarts.com/vocab/_Concept_hierarchy> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "A tree-style arrangement of terms or classes in which each child has only one parent (i.e., single inheritance)." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                       skos:prefLabel "hierarchy" .


###  http://www.semanticarts.com/vocab/_Concept_homonym
<http://www.semanticarts.com/vocab/_Concept_homonym> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Two different meanings sharing the same word and the same spelling." ;
                                                     skos:example "\"Mogul\" meaning the emperor versus \"mogul\" meaning the ski bump." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                     skos:prefLabel "homonym" .


###  http://www.semanticarts.com/vocab/_Concept_hypernymy
<http://www.semanticarts.com/vocab/_Concept_hypernymy> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "A word of a more specific meaning.  " ;
                                                       skos:example "\"Arabian\" is a kind of \"horse.\"" ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                       skos:prefLabel "hypernymy" .


###  http://www.semanticarts.com/vocab/_Concept_hypertextmarkuplanguage
<http://www.semanticarts.com/vocab/_Concept_hypertextmarkuplanguage> rdf:type owl:NamedIndividual ,
                                                                              skos:Concept ;
                                                                     skos:definition "A tag-based language on which the World Wide Web is based. " ;
                                                                     skos:hiddenLabel "HTML" ;
                                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards> ;
                                                                     skos:note "Markup is for presentation only." ;
                                                                     skos:prefLabel "hypertext markup language" .


###  http://www.semanticarts.com/vocab/_Concept_hypertexttransferprotocol
<http://www.semanticarts.com/vocab/_Concept_hypertexttransferprotocol> rdf:type owl:NamedIndividual ,
                                                                                skos:Concept ;
                                                                       skos:definition "A standard request to Web servers; the protocol on which much of the World Wide Web is based." ;
                                                                       skos:hiddenLabel "http" ;
                                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards> ;
                                                                       skos:prefLabel "hypertext transfer protocol" .


###  http://www.semanticarts.com/vocab/_Concept_hyponymy
<http://www.semanticarts.com/vocab/_Concept_hyponymy> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Inverse of hypernymy." ;
                                                      skos:example "”Mammal” is a more general type than “horse.”" ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                      skos:prefLabel "hyponymy" .


###  http://www.semanticarts.com/vocab/_Concept_identify
<http://www.semanticarts.com/vocab/_Concept_identify> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "To associate the description of an entity with its real-world counterpart." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                      skos:prefLabel "identify" .


###  http://www.semanticarts.com/vocab/_Concept_identity
<http://www.semanticarts.com/vocab/_Concept_identity> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "That which we perceive to be permanent about a perceived real-world entity; the identity of a person or an organization." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                      skos:prefLabel "identity" .


###  http://www.semanticarts.com/vocab/_Concept_idiolect
<http://www.semanticarts.com/vocab/_Concept_idiolect> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Dialect spoken by an individual." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_linguistics> ;
                                                      skos:prefLabel "idiolect" .


###  http://www.semanticarts.com/vocab/_Concept_individual
<http://www.semanticarts.com/vocab/_Concept_individual> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "An individual object as distinct from a type of object or class. This is often used synonomously with instance although that actually describes the membership of an individual in a class." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                        skos:prefLabel "individual" .


###  http://www.semanticarts.com/vocab/_Concept_induction
<http://www.semanticarts.com/vocab/_Concept_induction> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "Process of creating categories from instances. Probabilistic reasoning." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                       skos:prefLabel "induction" .


###  http://www.semanticarts.com/vocab/_Concept_inference
<http://www.semanticarts.com/vocab/_Concept_inference> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "Reasoning from known propositions." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                       skos:prefLabel "inference" .


###  http://www.semanticarts.com/vocab/_Concept_inferenceengine
<http://www.semanticarts.com/vocab/_Concept_inferenceengine> rdf:type owl:NamedIndividual ,
                                                                      skos:Concept ;
                                                             skos:altLabel "reasoner" ;
                                                             skos:definition "A software program that can assign members to classes based on formal class definitions." ;
                                                             skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                             skos:prefLabel "inference engine" .


###  http://www.semanticarts.com/vocab/_Concept_inheritance
<http://www.semanticarts.com/vocab/_Concept_inheritance> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "The accretion of properties and behaviors from a hyponym." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                         skos:prefLabel "inheritance" .


###  http://www.semanticarts.com/vocab/_Concept_instance
<http://www.semanticarts.com/vocab/_Concept_instance> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Individual objects that belong to a class are referred to as instances of that class. Individuals can be instances of several classes." ;
                                                      skos:example "e.g., Dave McComb is an instance of the class Person." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                      skos:prefLabel "instance" .


###  http://www.semanticarts.com/vocab/_Concept_instances
<http://www.semanticarts.com/vocab/_Concept_instances> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "Specific individual groups of data, usually created from some sort of template. In object-oriented systems, calling “new()” on a class creates an object that is of the type of the class. In a database system, inserting a row in a table creates an instance of that entity." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_softwaredesign,modeling> ;
                                                       skos:prefLabel "instances" .


###  http://www.semanticarts.com/vocab/_Concept_instantiate
<http://www.semanticarts.com/vocab/_Concept_instantiate> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "The act of creating an instance of a class." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_softwaredesign,modeling> ;
                                                         skos:prefLabel "instantiate" .


###  http://www.semanticarts.com/vocab/_Concept_intensional
<http://www.semanticarts.com/vocab/_Concept_intensional> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "A set defined by rules. Each time the rules are executed you might get a different set. The set of customers with overdue balances is an intensional set. Opposite of extensional." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                         skos:prefLabel "intensional" .


###  http://www.semanticarts.com/vocab/_Concept_intentional
<http://www.semanticarts.com/vocab/_Concept_intentional> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "A programming language and style, where the “intention” of the developer is captured separate from the details of the implementation." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_softwaredesign> ;
                                                         skos:prefLabel "intentional" .


###  http://www.semanticarts.com/vocab/_Concept_inverseof
<http://www.semanticarts.com/vocab/_Concept_inverseof> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "For bidirectional relationships, the one that \"goes the other way\" (\"child\" is the inverse of \"parent\")." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                       skos:prefLabel "inverse of" .


###  http://www.semanticarts.com/vocab/_Concept_isa
<http://www.semanticarts.com/vocab/_Concept_isa> rdf:type owl:NamedIndividual ,
                                                          skos:Concept ;
                                                 skos:definition "Member of.  " ,
                                                                 "Shorthand for the specialization/generalization relationship. Basis for inheritance in object-oriented design. See subsumption." ;
                                                 skos:example "Dave (instance) isa Person (type or class). The two forms of isa are often confounded." ;
                                                 skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modelinstancetotype> ,
                                                               <http://www.semanticarts.com/vocab/_Domain_modeltypetotype> ;
                                                 skos:prefLabel "isa" .


###  http://www.semanticarts.com/vocab/_Concept_keyword
<http://www.semanticarts.com/vocab/_Concept_keyword> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "To find content, we extract some of the less common words from a document and index them back to their location in the document." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                     skos:prefLabel "keyword" .


###  http://www.semanticarts.com/vocab/_Concept_knowledge
<http://www.semanticarts.com/vocab/_Concept_knowledge> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "An agent has knowledge of a scenario or context to the extent that it has a model that provides some degree of predictability." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                       skos:prefLabel "knowledge" .


###  http://www.semanticarts.com/vocab/_Concept_knowledgeinterchangeformat
<http://www.semanticarts.com/vocab/_Concept_knowledgeinterchangeformat> rdf:type owl:NamedIndividual ,
                                                                                 skos:Concept ;
                                                                        skos:definition "A standard format for exchanging rules between AI systems." ;
                                                                        skos:hiddenLabel "KIF" ;
                                                                        skos:prefLabel "knowledge interchange format" .


###  http://www.semanticarts.com/vocab/_Concept_knowledgelevel
<http://www.semanticarts.com/vocab/_Concept_knowledgelevel> rdf:type owl:NamedIndividual ,
                                                                     skos:Concept ;
                                                            skos:definition "Part of a model in which you reason about the behavior of the system rather than its implementation." ;
                                                            skos:inScheme <http://www.semanticarts.com/vocab/_Domain_AI,modeling> ;
                                                            skos:prefLabel "knowledge level" .


###  http://www.semanticarts.com/vocab/_Concept_lexical
<http://www.semanticarts.com/vocab/_Concept_lexical> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Having to do with words, as in a lexical analysis of text." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                     skos:prefLabel "lexical" .


###  http://www.semanticarts.com/vocab/_Concept_lexicographer
<http://www.semanticarts.com/vocab/_Concept_lexicographer> rdf:type owl:NamedIndividual ,
                                                                    skos:Concept ;
                                                           skos:definition "A person who writes dictionaries." ;
                                                           skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                           skos:prefLabel "lexicographer" .


###  http://www.semanticarts.com/vocab/_Concept_lexicon
<http://www.semanticarts.com/vocab/_Concept_lexicon> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Computer-readable dictionary of attributes." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                     skos:prefLabel "lexicon" .


###  http://www.semanticarts.com/vocab/_Concept_linguistic
<http://www.semanticarts.com/vocab/_Concept_linguistic> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Pertaining to language." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_linguistics> ;
                                                        skos:prefLabel "linguistic" .


###  http://www.semanticarts.com/vocab/_Concept_linkeddata
<http://www.semanticarts.com/vocab/_Concept_linkeddata> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_SemanticWeb> ;
                                                        skos:prefLabel "linked data" .


###  http://www.semanticarts.com/vocab/_Concept_literal
<http://www.semanticarts.com/vocab/_Concept_literal> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Constant variable (sounds like an oxymoron)." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                     skos:prefLabel "literal" .


###  http://www.semanticarts.com/vocab/_Concept_mandatory
<http://www.semanticarts.com/vocab/_Concept_mandatory> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "In a relationship, a constraint that a particular relationship must have at least one successor." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                       skos:prefLabel "mandatory" .


###  http://www.semanticarts.com/vocab/_Concept_markup
<http://www.semanticarts.com/vocab/_Concept_markup> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ;
                                                    skos:definition "Annotating documents by inserting matching tags to offset certain sections." ;
                                                    skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards> ;
                                                    skos:prefLabel "markup" .


###  http://www.semanticarts.com/vocab/_Concept_mashups
<http://www.semanticarts.com/vocab/_Concept_mashups> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Web-based user interface where integration is done in the browser using data from multiple sources." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_softwaredesign> ;
                                                     skos:prefLabel "mashups" .


###  http://www.semanticarts.com/vocab/_Concept_mereology
<http://www.semanticarts.com/vocab/_Concept_mereology> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:altLabel "partonomy" ;
                                                       skos:definition "The study of part-whole relationships. " ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                       skos:prefLabel "mereology" .


###  http://www.semanticarts.com/vocab/_Concept_meronomy
<http://www.semanticarts.com/vocab/_Concept_meronomy> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:altLabel "metonymy; meronymy" ;
                                                      skos:definition "Terms related through a part-whole relationship. " ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                      skos:prefLabel "meronomy" .


###  http://www.semanticarts.com/vocab/_Concept_message
<http://www.semanticarts.com/vocab/_Concept_message> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Object-oriented design refers to a method call as a message, even though it is a function call." ,
                                                                     "The unit of work in an SOA, often serialized as XML." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_object-orienteddesign> ;
                                                     skos:prefLabel "message" .


###  http://www.semanticarts.com/vocab/_Concept_meta
<http://www.semanticarts.com/vocab/_Concept_meta> rdf:type owl:NamedIndividual ,
                                                           skos:Concept ;
                                                  skos:definition "To transcend or go above. For most of computer science in means \"about,\" as in “metadata is data about data.\"" ;
                                                  skos:prefLabel "meta" .


###  http://www.semanticarts.com/vocab/_Concept_metadata
<http://www.semanticarts.com/vocab/_Concept_metadata> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Data about data. Includes data which describes how data is stored, where it is stored, how it is validated, and what it means." ;
                                                      skos:prefLabel "metadata" .


###  http://www.semanticarts.com/vocab/_Concept_metametadata
<http://www.semanticarts.com/vocab/_Concept_metametadata> rdf:type owl:NamedIndividual ,
                                                                   skos:Concept ;
                                                          skos:definition "Data about metadata (usually at a high level of abstraction)." ;
                                                          skos:prefLabel "metametadata" .


###  http://www.semanticarts.com/vocab/_Concept_metaphysics
<http://www.semanticarts.com/vocab/_Concept_metaphysics> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "A branch of philosophy that deals with understanding the fundamental nature of everything, particularly the relationship of mind to matter." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_philosophy> ;
                                                         skos:prefLabel "metaphysics" .


###  http://www.semanticarts.com/vocab/_Concept_microformats
<http://www.semanticarts.com/vocab/_Concept_microformats> rdf:type owl:NamedIndividual ,
                                                                   skos:Concept ;
                                                          skos:definition "An approach to embedding small bits of semantics in XML or XHTML." ;
                                                          skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards> ;
                                                          skos:prefLabel "microformats" .


###  http://www.semanticarts.com/vocab/_Concept_model-theoreticsemantics
<http://www.semanticarts.com/vocab/_Concept_model-theoreticsemantics> rdf:type owl:NamedIndividual ,
                                                                               skos:Concept ;
                                                                      skos:definition "An account of meaning in which sentences are interpreted in terms of a model of, or abstract formal structure representing, an actual or possible state of the world." ;
                                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                                      skos:prefLabel "model-theoretic semantics" .


###  http://www.semanticarts.com/vocab/_Concept_namespace
<http://www.semanticarts.com/vocab/_Concept_namespace> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "A domain within which a name is guaranteed to be unique and findable." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                       skos:prefLabel "namespace" .


###  http://www.semanticarts.com/vocab/_Concept_naturallanguageprocessing
<http://www.semanticarts.com/vocab/_Concept_naturallanguageprocessing> rdf:type owl:NamedIndividual ,
                                                                                skos:Concept ;
                                                                       skos:definition "A branch of artificial intelligence that deals with interpreting and generating humanlike speech." ;
                                                                       skos:hiddenLabel "NLP" ;
                                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_artificialintelligence> ;
                                                                       skos:prefLabel "natural language processing" .


###  http://www.semanticarts.com/vocab/_Concept_navigational
<http://www.semanticarts.com/vocab/_Concept_navigational> rdf:type owl:NamedIndividual ,
                                                                   skos:Concept ;
                                                          skos:definition "Non-formal taxonomies intended to aid users in finding information in a large source." ;
                                                          skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                          skos:prefLabel "navigational" .


###  http://www.semanticarts.com/vocab/_Concept_nodefolding
<http://www.semanticarts.com/vocab/_Concept_nodefolding> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "Process whereby a large number of independently defined “triples” are combined into a logical graph." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_RDF> ;
                                                         skos:prefLabel "node folding" .


###  http://www.semanticarts.com/vocab/_Concept_nomenclature
<http://www.semanticarts.com/vocab/_Concept_nomenclature> rdf:type owl:NamedIndividual ,
                                                                   skos:Concept ;
                                                          skos:definition "Set of names for terms in a given domain." ;
                                                          skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                          skos:prefLabel "nomenclature" .


###  http://www.semanticarts.com/vocab/_Concept_nominalization
<http://www.semanticarts.com/vocab/_Concept_nominalization> rdf:type owl:NamedIndividual ,
                                                                     skos:Concept ;
                                                            skos:definition "To convert a verb to a noun. Used in software programs to create a handle for a method." ;
                                                            skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                            skos:prefLabel "nominalization" .


###  http://www.semanticarts.com/vocab/_Concept_normalization
<http://www.semanticarts.com/vocab/_Concept_normalization> rdf:type owl:NamedIndividual ,
                                                                    skos:Concept ;
                                                           skos:definition "Arrangement of attributes to tables in a relational design so as to avoid update anomalies. Ensuring that each property is dependent only on the primary keys of its table." ;
                                                           skos:inScheme <http://www.semanticarts.com/vocab/_Domain_database> ;
                                                           skos:prefLabel "normalization" .


###  http://www.semanticarts.com/vocab/_Concept_objectoriented
<http://www.semanticarts.com/vocab/_Concept_objectoriented> rdf:type owl:NamedIndividual ,
                                                                     skos:Concept ;
                                                            skos:definition "Style of programming that features data hiding within classes, and type and property inheritance. " ;
                                                            skos:hiddenLabel "OO" ;
                                                            skos:inScheme <http://www.semanticarts.com/vocab/_Domain_objectoriented> ;
                                                            skos:prefLabel "object oriented" .


###  http://www.semanticarts.com/vocab/_Concept_objectrolemodeling
<http://www.semanticarts.com/vocab/_Concept_objectrolemodeling> rdf:type owl:NamedIndividual ,
                                                                         skos:Concept ;
                                                                skos:definition "Conceptual design notation focused on role modeling. Enables good modeling, especially for relationships of higher valence." ;
                                                                skos:hiddenLabel "ORM" ;
                                                                skos:inScheme <http://www.semanticarts.com/vocab/_Domain_objectrolemodeling> ;
                                                                skos:prefLabel "object role modeling" .


###  http://www.semanticarts.com/vocab/_Concept_ontology
<http://www.semanticarts.com/vocab/_Concept_ontology> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "A specification of a conceptualization." ,
                                                                      "A subdiscipline of metaphysics which concerns itself with the nature of being." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_philosophy> ,
                                                                    <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                      skos:prefLabel "ontology" .


###  http://www.semanticarts.com/vocab/_Concept_ontologyinferencelayer
<http://www.semanticarts.com/vocab/_Concept_ontologyinferencelayer> rdf:type owl:NamedIndividual ,
                                                                             skos:Concept ;
                                                                    skos:definition "Standard for defining and interchanging ontologies." ;
                                                                    skos:hiddenLabel "OIL" ;
                                                                    skos:prefLabel "ontology inference layer" .


###  http://www.semanticarts.com/vocab/_Concept_orthogonality
<http://www.semanticarts.com/vocab/_Concept_orthogonality> rdf:type owl:NamedIndividual ,
                                                                    skos:Concept ;
                                                           skos:altLabel "facets" ;
                                                           skos:definition "Literally \"at right angles.\" Refers to finding aspects of categorization that are as independent of each other as possible." ;
                                                           skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                           skos:prefLabel "orthogonality" .


###  http://www.semanticarts.com/vocab/_Concept_parse
<http://www.semanticarts.com/vocab/_Concept_parse> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "To separate an incoming stream of data into its constituent parts based on a grammer and various delimiters." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_software> ;
                                                   skos:prefLabel "parse" .


###  http://www.semanticarts.com/vocab/_Concept_parsedcharacterdata
<http://www.semanticarts.com/vocab/_Concept_parsedcharacterdata> rdf:type owl:NamedIndividual ,
                                                                          skos:Concept ;
                                                                 skos:definition "Text that can be parsed." ;
                                                                 skos:hiddenLabel "PCDATA" ;
                                                                 skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards,XML,HTML> ;
                                                                 skos:prefLabel "parsed character data" ;
                                                                 skos:related "character data" .


###  http://www.semanticarts.com/vocab/_Concept_partial
<http://www.semanticarts.com/vocab/_Concept_partial> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "A partial class is one that has necessary, but not necessary and sufficient restrictions." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_OWL,modeling> ;
                                                     skos:prefLabel "partial" ;
                                                     skos:related "complete" .


###  http://www.semanticarts.com/vocab/_Concept_partonomy
<http://www.semanticarts.com/vocab/_Concept_partonomy> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:altLabel "mereology" ;
                                                       skos:definition "A mereological hierarchy; a type of hierarchy that deals with part–whole relationships." ;
                                                       skos:example "A bill of materials" ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                       skos:prefLabel "partonomy" .


###  http://www.semanticarts.com/vocab/_Concept_perception
<http://www.semanticarts.com/vocab/_Concept_perception> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "The process whereby humans discern order in a complex world." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_metaphysics> ;
                                                        skos:prefLabel "perception" .


###  http://www.semanticarts.com/vocab/_Concept_phenomenology
<http://www.semanticarts.com/vocab/_Concept_phenomenology> rdf:type owl:NamedIndividual ,
                                                                    skos:Concept ;
                                                           skos:definition "A branch of metaphysics that reality consists of objects and events as perceived by human consciousness." ;
                                                           skos:inScheme <http://www.semanticarts.com/vocab/_Domain_metaphysics> ;
                                                           skos:prefLabel "phenomenology" ;
                                                           skos:related "sophists" .


###  http://www.semanticarts.com/vocab/_Concept_polymorphism
<http://www.semanticarts.com/vocab/_Concept_polymorphism> rdf:type owl:NamedIndividual ,
                                                                   skos:Concept ;
                                                          skos:definition "Literally \"to take many forms.\" In object-oOriented design, subclasses of a class implement the public interface to the parent class in such a way that a message sent to a collection of parents and children would be responded to by each appropriately, without the caller knowing." ;
                                                          skos:inScheme <http://www.semanticarts.com/vocab/_Domain_object-orienteddesign> ;
                                                          skos:prefLabel "polymorphism" .


###  http://www.semanticarts.com/vocab/_Concept_polysemous
<http://www.semanticarts.com/vocab/_Concept_polysemous> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "A word with multiple related meanings." ;
                                                        skos:example "Mouth, the anatomic opening, and mouth, the opening of a cave." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                        skos:prefLabel "polysemous" .


###  http://www.semanticarts.com/vocab/_Concept_pragmatism
<http://www.semanticarts.com/vocab/_Concept_pragmatism> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "A branch of philosophy that holds that both the meaning and the truth of any idea is a function of its practical outcome." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_philosophy> ;
                                                        skos:prefLabel "pragmatism" .


###  http://www.semanticarts.com/vocab/_Concept_precisionsemantic
<http://www.semanticarts.com/vocab/_Concept_precisionsemantic> rdf:type owl:NamedIndividual ,
                                                                        skos:Concept ;
                                                               skos:definition "The degree of refinement or specificity applied to a particular semantic categorization." ;
                                                               skos:example "\"Car repair manual\" is a more semantically precise term than \"document,\" even though both may be equally accurate." ;
                                                               skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics,modeling> ;
                                                               skos:prefLabel "precision (semantic)" .


###  http://www.semanticarts.com/vocab/_Concept_predicate
<http://www.semanticarts.com/vocab/_Concept_predicate> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "A statement you can make about something that can be evaluated later as true or false." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                       skos:prefLabel "predicate" .


###  http://www.semanticarts.com/vocab/_Concept_prime
<http://www.semanticarts.com/vocab/_Concept_prime> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "Types which are atomic and have no supertypes. There is a belief that there are a few semantic primes from which all business-related applications can be built." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                   skos:prefLabel "prime" .


###  http://www.semanticarts.com/vocab/_Concept_property
<http://www.semanticarts.com/vocab/_Concept_property> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "An attribute (Datatype) or relationship (ObjectType) of an object/individual." ,
                                                                      "In object-oriented design, either an attribute or a relationship." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_model> ,
                                                                    <http://www.semanticarts.com/vocab/_Domain_ontology> ;
                                                      skos:prefLabel "property" .


###  http://www.semanticarts.com/vocab/_Concept_prototypes
<http://www.semanticarts.com/vocab/_Concept_prototypes> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "A way of defining categories around exemplar representatives." ;
                                                        skos:example "A \"robin\" may be a prototype for the category \"bird.\"" ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_classificationtheory> ;
                                                        skos:prefLabel "prototypes" .


###  http://www.semanticarts.com/vocab/_Concept_query
<http://www.semanticarts.com/vocab/_Concept_query> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "A declarative statement describing the dataset that a user or program wants to obtain from a database." ,
                                                                   "To request information from a data store." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_applicationverb> ,
                                                                 <http://www.semanticarts.com/vocab/_Domain_databasenoun> ;
                                                   skos:prefLabel "query" .


###  http://www.semanticarts.com/vocab/_Concept_range
<http://www.semanticarts.com/vocab/_Concept_range> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "A restricted set of the domain of values to which an attribute can belong." ,
                                                                   "Restriction class for a property. See slot and domain (ontology)." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_ontology> ;
                                                   skos:prefLabel "range" .


###  http://www.semanticarts.com/vocab/_Concept_reachable
<http://www.semanticarts.com/vocab/_Concept_reachable> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "The set of all nodes in a graph that can be arrived at by traversing arcs." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_graphtheory> ;
                                                       skos:prefLabel "reachable" .


###  http://www.semanticarts.com/vocab/_Concept_real-time
<http://www.semanticarts.com/vocab/_Concept_real-time> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "System design where events in the computer are taking place at nearly the same clock time as in the real world. " ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_systems> ;
                                                       skos:prefLabel "real-time" .


###  http://www.semanticarts.com/vocab/_Concept_reallysimplesyndicationrdfsitesummaryrichsitesummary
<http://www.semanticarts.com/vocab/_Concept_reallysimplesyndicationrdfsitesummaryrichsitesummary> rdf:type owl:NamedIndividual ,
                                                                                                           skos:Concept ;
                                                                                                  skos:definition "A family of standards for bloggers and content syndication." ;
                                                                                                  skos:hiddenLabel "RSS" ;
                                                                                                  skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standard> ;
                                                                                                  skos:prefLabel "really simple syndication/rdf site summary/rich site summary" .


###  http://www.semanticarts.com/vocab/_Concept_reasoner
<http://www.semanticarts.com/vocab/_Concept_reasoner> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:altLabel "inference engine" ;
                                                      skos:definition "A software program that can assign members to classes based on formal class definitions." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                      skos:prefLabel "reasoner" .


###  http://www.semanticarts.com/vocab/_Concept_recursive
<http://www.semanticarts.com/vocab/_Concept_recursive> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "Flow of control in which a module calls a new instance of itself an indefinite number of times. See recursive. " ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_programming> ;
                                                       skos:prefLabel "recursive" .


###  http://www.semanticarts.com/vocab/_Concept_referent
<http://www.semanticarts.com/vocab/_Concept_referent> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "The real world object which an individual represents in an ontology. " ;
                                                      skos:example "“Horse” is a symbol, which stands for a concept. The referent is what kicks you." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                      skos:prefLabel "referent" .


###  http://www.semanticarts.com/vocab/_Concept_referentialintegrity
<http://www.semanticarts.com/vocab/_Concept_referentialintegrity> rdf:type owl:NamedIndividual ,
                                                                           skos:Concept ;
                                                                  skos:definition "Property of database management system that allows it to manage the relationship of instances in different tables such that a change or deletion in one table does not invalidate information in another. Referential integrity would prevent the deletion of a customer if there were still orders outstanding for that customer." ;
                                                                  skos:inScheme <http://www.semanticarts.com/vocab/_Domain_database> ;
                                                                  skos:prefLabel "referential integrity" .


###  http://www.semanticarts.com/vocab/_Concept_reification
<http://www.semanticarts.com/vocab/_Concept_reification> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "Statements that refer to other RDF statements. For instance, to make a reference that another assertion is false or dubious is a reification." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_RDF> ;
                                                         skos:prefLabel "reification" .


###  http://www.semanticarts.com/vocab/_Concept_reify
<http://www.semanticarts.com/vocab/_Concept_reify> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "To treat an abstraction as if it were real. " ;
                                                   skos:example "Marriage is the reification of a relationship, as are most entities in most databases." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                   skos:prefLabel "reify" .


###  http://www.semanticarts.com/vocab/_Concept_repository
<http://www.semanticarts.com/vocab/_Concept_repository> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Place to persistently store metadata. A database for metadata." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_metadata> ;
                                                        skos:prefLabel "repository" .


###  http://www.semanticarts.com/vocab/_Concept_resource
<http://www.semanticarts.com/vocab/_Concept_resource> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "In RDF terms, a URI or a literal." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_RDF> ;
                                                      skos:prefLabel "resource" .


###  http://www.semanticarts.com/vocab/_Concept_resourcedescriptionframework
<http://www.semanticarts.com/vocab/_Concept_resourcedescriptionframework> rdf:type owl:NamedIndividual ,
                                                                                   skos:Concept ;
                                                                          skos:definition "Basic model for expressing knowledge in the Semantic Web." ;
                                                                          skos:hiddenLabel "RDF" ;
                                                                          skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards,semanticweb> ;
                                                                          skos:prefLabel "resource description framework" .


###  http://www.semanticarts.com/vocab/_Concept_resourcedescriptionframeworkschema
<http://www.semanticarts.com/vocab/_Concept_resourcedescriptionframeworkschema> rdf:type owl:NamedIndividual ,
                                                                                         skos:Concept ;
                                                                                skos:definition "Adds schema properties to RDF, such as \"subclass\" and \"inverse.\"" ;
                                                                                skos:hiddenLabel "RDFS" ;
                                                                                skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards,semanticweb> ;
                                                                                skos:prefLabel "resource description framework schema" .


###  http://www.semanticarts.com/vocab/_Concept_restriction
<http://www.semanticarts.com/vocab/_Concept_restriction> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "A class definition where membership can be inferred based on precise definitions of membership qualification." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_descriptionlogics> ;
                                                         skos:prefLabel "restriction" .


###  http://www.semanticarts.com/vocab/_Concept_runtime
<http://www.semanticarts.com/vocab/_Concept_runtime> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Refers to things which can change when the program is running as opposed to those things which must be changed when the program is being designed (or compiled). Shifting things (e.g., hardware, software, data) from design time to run time can make the system much more flexible." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_software> ;
                                                     skos:prefLabel "run time" .


###  http://www.semanticarts.com/vocab/_Concept_schema
<http://www.semanticarts.com/vocab/_Concept_schema> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ;
                                                    skos:definition "Allowable tags and their sequencing, usually expressed in DTD or XSD." ,
                                                                    "Data definition for tables." ;
                                                    skos:inScheme <http://www.semanticarts.com/vocab/_Domain_XML> ,
                                                                  <http://www.semanticarts.com/vocab/_Domain_database> ;
                                                    skos:prefLabel "schema" .


###  http://www.semanticarts.com/vocab/_Concept_semantic
<http://www.semanticarts.com/vocab/_Concept_semantic> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Concerned with the study of meaning (often the meaning of words). In business systems we are concerned with making the meaning of data explicit (structuring unstructured data), as well as making it explicit enough that an agent could reason about it." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_philosophy> ;
                                                      skos:prefLabel "semantic" .


###  http://www.semanticarts.com/vocab/_Concept_semanticdatamodeling
<http://www.semanticarts.com/vocab/_Concept_semanticdatamodeling> rdf:type owl:NamedIndividual ,
                                                                           skos:Concept ;
                                                                  skos:definition "Conceptual database modeling based on semantics." ;
                                                                  skos:hiddenLabel "SDM" ;
                                                                  skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                                  skos:prefLabel "semantic data modeling" .


###  http://www.semanticarts.com/vocab/_Concept_semiotics
<http://www.semanticarts.com/vocab/_Concept_semiotics> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "A branch of linguistics primarily concerned with human use of sign, symbol, syntax, and semantics." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_linguistics> ;
                                                       skos:prefLabel "semiotics" .


###  http://www.semanticarts.com/vocab/_Concept_sentient
<http://www.semanticarts.com/vocab/_Concept_sentient> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Capable of reasoning. Alternative definition includes being capable of feeling, but that has no applicability for business systems." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_philosophyofmind> ;
                                                      skos:prefLabel "sentient" .


###  http://www.semanticarts.com/vocab/_Concept_service-orientedarchitecture
<http://www.semanticarts.com/vocab/_Concept_service-orientedarchitecture> rdf:type owl:NamedIndividual ,
                                                                                   skos:Concept ;
                                                                          skos:definition "Application architecture organized around the use of services, including Web services." ;
                                                                          skos:hiddenLabel "SOA" ;
                                                                          skos:prefLabel "service-oriented architecture" ;
                                                                          skos:related "Business Process Execution Language" .


###  http://www.semanticarts.com/vocab/_Concept_service-orientedintegration
<http://www.semanticarts.com/vocab/_Concept_service-orientedintegration> rdf:type owl:NamedIndividual ,
                                                                                  skos:Concept ;
                                                                         skos:definition "Performing EAI using service-based technologies." ;
                                                                         skos:hiddenLabel "SOI" ;
                                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_service-orientedintegration> ;
                                                                         skos:prefLabel "service-oriented integration" .


###  http://www.semanticarts.com/vocab/_Concept_shredding
<http://www.semanticarts.com/vocab/_Concept_shredding> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "Parsing an XML document to is constituent parts to be stored atomically in a relational database." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_XML> ;
                                                       skos:prefLabel "shredding" .


###  http://www.semanticarts.com/vocab/_Concept_similarity
<http://www.semanticarts.com/vocab/_Concept_similarity> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Lexical relations of words with related meaning. For example, \"gluttonous\" is similar to \"greedy.\"" ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                        skos:prefLabel "similarity" .


###  http://www.semanticarts.com/vocab/_Concept_simpleHTMLontologyextension
<http://www.semanticarts.com/vocab/_Concept_simpleHTMLontologyextension> rdf:type owl:NamedIndividual ,
                                                                                  skos:Concept ;
                                                                         skos:definition "An early project to extend HTML with semantic tags." ;
                                                                         skos:hiddenLabel "SHOE" ;
                                                                         skos:prefLabel "simple HTML ontology extension" .


###  http://www.semanticarts.com/vocab/_Concept_simpleobjectaccessprotocol
<http://www.semanticarts.com/vocab/_Concept_simpleobjectaccessprotocol> rdf:type owl:NamedIndividual ,
                                                                                 skos:Concept ;
                                                                        skos:definition "Wrapper for Web service requests that allows them to be invoked across the  Internet, including through firewalls." ;
                                                                        skos:hiddenLabel "SOAP" ;
                                                                        skos:prefLabel "simple object access protocol" .


###  http://www.semanticarts.com/vocab/_Concept_slot
<http://www.semanticarts.com/vocab/_Concept_slot> rdf:type owl:NamedIndividual ,
                                                           skos:Concept ;
                                                  skos:definition "A property in an ontology that can refer to other terms or frames." ;
                                                  skos:inScheme <http://www.semanticarts.com/vocab/_Domain_ontology> ;
                                                  skos:prefLabel "slot" .


###  http://www.semanticarts.com/vocab/_Concept_sophists
<http://www.semanticarts.com/vocab/_Concept_sophists> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "A group of philosophers who believed that the world existed only to the extent it was perceived. \"Man is the measure of all things\" was a saying of the sophists." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_philosophy> ;
                                                      skos:prefLabel "sophists" ;
                                                      skos:related "phenomenology" .


###  http://www.semanticarts.com/vocab/_Concept_specialization
<http://www.semanticarts.com/vocab/_Concept_specialization> rdf:type owl:NamedIndividual ,
                                                                     skos:Concept ;
                                                            skos:definition "Increasing semantic precision by subtyping. Almost an exact antonym to generalization, but there are a few obscure conditions where generalization and specialization are not inverses." ;
                                                            skos:inScheme <http://www.semanticarts.com/vocab/_Domain_ontology> ;
                                                            skos:prefLabel "specialization" .


###  http://www.semanticarts.com/vocab/_Concept_splitters
<http://www.semanticarts.com/vocab/_Concept_splitters> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "People who are inclined to create new categories whenever new distinctions come up." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_ontology> ;
                                                       skos:prefLabel "splitters" ;
                                                       skos:related "lumpers" .


###  http://www.semanticarts.com/vocab/_Concept_standardgeneralizedmarkuplanguage
<http://www.semanticarts.com/vocab/_Concept_standardgeneralizedmarkuplanguage> rdf:type owl:NamedIndividual ,
                                                                                        skos:Concept ;
                                                                               skos:definition "Early tagged document markup language. Was popular for complex document creation, but complexity of language led to it being largely superceded by HTML and XML." ;
                                                                               skos:hiddenLabel "SGML" ;
                                                                               skos:inScheme <http://www.semanticarts.com/vocab/_Domain_standards> ;
                                                                               skos:prefLabel "standard generalized markup language" .


###  http://www.semanticarts.com/vocab/_Concept_subsumption
<http://www.semanticarts.com/vocab/_Concept_subsumption> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "To classify, include or incorporate in a more comprehensive category or under a general principle. The \"isa\" relationship." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_ontology> ;
                                                         skos:prefLabel "subsumption" ;
                                                         skos:related "lumpers" .


###  http://www.semanticarts.com/vocab/_Concept_subtype
<http://www.semanticarts.com/vocab/_Concept_subtype> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "A proper subtype \"is\" one of its parent types, more specifically a specialization of that type." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_ontology> ;
                                                     skos:prefLabel "subtype" .


###  http://www.semanticarts.com/vocab/_Concept_suggesteduppermergedontology
<http://www.semanticarts.com/vocab/_Concept_suggesteduppermergedontology> rdf:type owl:NamedIndividual ,
                                                                                   skos:Concept ;
                                                                          skos:definition "A broad ontology meant to promote wide ranging interoperability, supported by IEEE." ;
                                                                          skos:hiddenLabel "SUMO" ;
                                                                          skos:prefLabel "suggested upper merged ontology" .


###  http://www.semanticarts.com/vocab/_Concept_swoRDFish
<http://www.semanticarts.com/vocab/_Concept_swoRDFish> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "Ontology and framework for managing digital assets, from Sun Microsystems." ;
                                                       skos:prefLabel "swoRDFish" .


###  http://www.semanticarts.com/vocab/_Concept_syllogism
<http://www.semanticarts.com/vocab/_Concept_syllogism> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "A style of inductive logic, that starts with a generalization, includes a categorization and concludes with a semantic entailment or the instance taking on an attribute of the category." ;
                                                       skos:example "All men are mortal (generalization). Socrates is a man (categorization). Socrates is mortal (XXX)." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_logic> ;
                                                       skos:prefLabel "syllogism" .


###  http://www.semanticarts.com/vocab/_Concept_symbolic
<http://www.semanticarts.com/vocab/_Concept_symbolic> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Semantic reasoning with variables substituted for semantically known objects. Conclusions drawn at this level are universally true." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_AI,semantics> ;
                                                      skos:prefLabel "symbolic" .


###  http://www.semanticarts.com/vocab/_Concept_symmetric
<http://www.semanticarts.com/vocab/_Concept_symmetric> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "Characteristic of a property which has it hold “both ways.” " ;
                                                       skos:example "“Sibling” is a symmetric property, but “sister” is not." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_descriptionlogic> ;
                                                       skos:prefLabel "symmetric" .


###  http://www.semanticarts.com/vocab/_Concept_synchronous
<http://www.semanticarts.com/vocab/_Concept_synchronous> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "Message transmission where sender blocks and waits for reply, which is expected in near real time." ;
                                                         skos:prefLabel "synchronous" .


###  http://www.semanticarts.com/vocab/_Concept_synonymy
<http://www.semanticarts.com/vocab/_Concept_synonymy> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Two terms that mean the same thing. As pointed out by John Saeed*, there are few true synonyms." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_ontology> ;
                                                      skos:prefLabel "synonymy" .


###  http://www.semanticarts.com/vocab/_Concept_syntactic
<http://www.semanticarts.com/vocab/_Concept_syntactic> rdf:type owl:NamedIndividual ,
                                                                skos:Concept ;
                                                       skos:definition "Concerning the grammar order or special characters in a document or message." ;
                                                       skos:inScheme <http://www.semanticarts.com/vocab/_Domain_grammar> ;
                                                       skos:prefLabel "syntactic" .


###  http://www.semanticarts.com/vocab/_Concept_tacit
<http://www.semanticarts.com/vocab/_Concept_tacit> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "That which has not been expressed in formal terms. Tacit knowledge may be knowledge we have without knowing that we have it." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                   skos:prefLabel "tacit" .


###  http://www.semanticarts.com/vocab/_Concept_tag
<http://www.semanticarts.com/vocab/_Concept_tag> rdf:type owl:NamedIndividual ,
                                                          skos:Concept ;
                                                 skos:definition "Delimiters that also contain information. Most common type are matched tags such as <t>42</t>, which is the number 42 tagged by the tag \"t.\"" ;
                                                 skos:inScheme <http://www.semanticarts.com/vocab/_Domain_markup> ;
                                                 skos:prefLabel "tag" .


###  http://www.semanticarts.com/vocab/_Concept_taxonomy
<http://www.semanticarts.com/vocab/_Concept_taxonomy> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "A vocabulary ordered into a hierarchy, generally to find terms easily, and also to subtype the terms." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                      skos:prefLabel "taxonomy" .


###  http://www.semanticarts.com/vocab/_Concept_temporal
<http://www.semanticarts.com/vocab/_Concept_temporal> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Dealing with time. " ;
                                                      skos:example "Events, plans" ;
                                                      skos:prefLabel "temporal" .


###  http://www.semanticarts.com/vocab/_Concept_terminologybox
<http://www.semanticarts.com/vocab/_Concept_terminologybox> rdf:type owl:NamedIndividual ,
                                                                     skos:Concept ;
                                                            skos:altLabel "Tbox, T-Box" ;
                                                            skos:definition "Inference that can be done with the Terminology (metadata) layer only." ;
                                                            skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                            skos:note "TBox statements are sometimes associated with object-oriented classes and ABox statements associated with instances of those classes." ;
                                                            skos:prefLabel "terminology box" ;
                                                            skos:related "Abox, Cbox" .


###  http://www.semanticarts.com/vocab/_Concept_text
<http://www.semanticarts.com/vocab/_Concept_text> rdf:type owl:NamedIndividual ,
                                                           skos:Concept ;
                                                  skos:definition "A portion of a document expressed in characters (as opposed to sound or graphics)." ;
                                                  skos:prefLabel "text" .


###  http://www.semanticarts.com/vocab/_Concept_thing
<http://www.semanticarts.com/vocab/_Concept_thing> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "Very often the top of a generalization tree." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                   skos:prefLabel "thing" ;
                                                   skos:related "class" .


###  http://www.semanticarts.com/vocab/_Concept_transactive
<http://www.semanticarts.com/vocab/_Concept_transactive> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "A characteristic of a property which allows it to be recursive. " ;
                                                         skos:example "“Ancestor” is a transitive property, but “parent” is not." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_descriptionlogics> ;
                                                         skos:prefLabel "transactive" .


###  http://www.semanticarts.com/vocab/_Concept_tree
<http://www.semanticarts.com/vocab/_Concept_tree> rdf:type owl:NamedIndividual ,
                                                           skos:Concept ;
                                                  skos:definition "A directed graph in which nodes are not referred to by more than one node." ;
                                                  skos:inScheme <http://www.semanticarts.com/vocab/_Domain_modeling> ;
                                                  skos:note "Children do not have more than one parent." ;
                                                  skos:prefLabel "tree" .


###  http://www.semanticarts.com/vocab/_Concept_triple
<http://www.semanticarts.com/vocab/_Concept_triple> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ;
                                                    skos:definition "A single combination of Subject/Predicate/Object." ,
                                                                    "Knowledge expressed in a three-part grammar, which has been called \"subject, predicate, object\" as well as “resource, property, values.\"" ;
                                                    skos:inScheme <http://www.semanticarts.com/vocab/_Domain_RDF> ,
                                                                  <http://www.semanticarts.com/vocab/_Domain_SemanticWeb,RDF> ;
                                                    skos:prefLabel "triple" .


###  http://www.semanticarts.com/vocab/_Concept_triplestore
<http://www.semanticarts.com/vocab/_Concept_triplestore> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "A database that stores RDF in its native form." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_RDF> ;
                                                         skos:prefLabel "triple store" .


###  http://www.semanticarts.com/vocab/_Concept_truthconditions
<http://www.semanticarts.com/vocab/_Concept_truthconditions> rdf:type owl:NamedIndividual ,
                                                                      skos:Concept ;
                                                             skos:definition "The conditions under which a sentence or a proposition expressed by it is true;" ;
                                                             skos:example "The statement “I have red hair” is true under the condition that the speaker has, in fact, red hair. It is not true in the abstract, but only when grounded." ;
                                                             skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                             skos:prefLabel "truth conditions" .


###  http://www.semanticarts.com/vocab/_Concept_unambiguous
<http://www.semanticarts.com/vocab/_Concept_unambiguous> rdf:type owl:NamedIndividual ,
                                                                  skos:Concept ;
                                                         skos:definition "Refers to specific item or category in requisite level of semantic precision." ;
                                                         skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                         skos:prefLabel "unambiguous" .


###  http://www.semanticarts.com/vocab/_Concept_unary
<http://www.semanticarts.com/vocab/_Concept_unary> rdf:type owl:NamedIndividual ,
                                                            skos:Concept ;
                                                   skos:definition "One-way relation; pointer.Most relations are binary, which means they are automatically maintained both ways and can be traversed both ways." ;
                                                   skos:inScheme <http://www.semanticarts.com/vocab/_Domain_relation> ;
                                                   skos:prefLabel "unary" .


###  http://www.semanticarts.com/vocab/_Concept_unicode
<http://www.semanticarts.com/vocab/_Concept_unicode> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Character set rich enough to represent non-Latin-based languages, such as Chinese and Burmese." ;
                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_characterset> ;
                                                     skos:prefLabel "unicode" .


###  http://www.semanticarts.com/vocab/_Concept_unifiedmedicallanguagesystem
<http://www.semanticarts.com/vocab/_Concept_unifiedmedicallanguagesystem> rdf:type owl:NamedIndividual ,
                                                                                   skos:Concept ;
                                                                          skos:definition "Ontology of medical terms used for searching medical literature." ;
                                                                          skos:hiddenLabel "UMLS" ;
                                                                          skos:inScheme <http://www.semanticarts.com/vocab/_Domain_model> ;
                                                                          skos:prefLabel "unified medical language system" .


###  http://www.semanticarts.com/vocab/_Concept_unifiedmodelinglanguage
<http://www.semanticarts.com/vocab/_Concept_unifiedmodelinglanguage> rdf:type owl:NamedIndividual ,
                                                                              skos:Concept ;
                                                                     skos:definition "Modeling language for object-oriented development popularized by Rational Corporation." ;
                                                                     skos:hiddenLabel "UML" ;
                                                                     skos:inScheme <http://www.semanticarts.com/vocab/_Domain_model> ;
                                                                     skos:prefLabel "unified modeling language" .


###  http://www.semanticarts.com/vocab/_Concept_uniformresourceidentifier
<http://www.semanticarts.com/vocab/_Concept_uniformresourceidentifier> rdf:type owl:NamedIndividual ,
                                                                                skos:Concept ;
                                                                       skos:definition "Unambiguous location of a resource in RDF." ;
                                                                       skos:hiddenLabel "URI" ;
                                                                       skos:prefLabel "uniform resource identifier" .


###  http://www.semanticarts.com/vocab/_Concept_uniformresourcelocation
<http://www.semanticarts.com/vocab/_Concept_uniformresourcelocation> rdf:type owl:NamedIndividual ,
                                                                              skos:Concept ;
                                                                     skos:definition "A resolvable location on the reachable  Internet." ;
                                                                     skos:hiddenLabel "URL" ;
                                                                     skos:prefLabel "uniform resource location" .


###  http://www.semanticarts.com/vocab/_Concept_unique
<http://www.semanticarts.com/vocab/_Concept_unique> rdf:type owl:NamedIndividual ,
                                                             skos:Concept ;
                                                    skos:definition "There can not be more than one equivalent item of this type within the scope indicated. We may say that customer numbers must be unique (within our organization or database) or we may say that there can only be one successor on a relationship, meaning there can't be more than one of that type in that set." ;
                                                    skos:prefLabel "unique" .


###  http://www.semanticarts.com/vocab/_Concept_unstructureddata
<http://www.semanticarts.com/vocab/_Concept_unstructureddata> rdf:type owl:NamedIndividual ,
                                                                       skos:Concept ;
                                                              skos:definition "Data (textual, video, sound, graphics) that has not been interpreted, tagged, or structured." ;
                                                              skos:prefLabel "unstructured data" .


###  http://www.semanticarts.com/vocab/_Concept_valence
<http://www.semanticarts.com/vocab/_Concept_valence> rdf:type owl:NamedIndividual ,
                                                              skos:Concept ;
                                                     skos:definition "Number of type of successors to a relationship. Also called the \"n-arity.\" Most relationships have a valence of 2 (binary relationships), but relationships with a valence of 3 or 4 are not uncommon." ;
                                                     skos:prefLabel "valence" .


###  http://www.semanticarts.com/vocab/_Concept_validation
<http://www.semanticarts.com/vocab/_Concept_validation> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "Determination that a document obeys all the rules set out in its schema." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_XML,HTML> ;
                                                        skos:prefLabel "validation" .


###  http://www.semanticarts.com/vocab/_Concept_veracity
<http://www.semanticarts.com/vocab/_Concept_veracity> rdf:type owl:NamedIndividual ,
                                                               skos:Concept ;
                                                      skos:definition "Degree to which we believe something to be true." ;
                                                      skos:example "High veracity = high degree in belief in the truth of the assertion." ;
                                                      skos:inScheme <http://www.semanticarts.com/vocab/_Domain_semantics> ;
                                                      skos:prefLabel "veracity" .


###  http://www.semanticarts.com/vocab/_Concept_vocabulary
<http://www.semanticarts.com/vocab/_Concept_vocabulary> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "List of terms in a particular dialect, often with definitions." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_lexicography> ;
                                                        skos:prefLabel "vocabulary" .


###  http://www.semanticarts.com/vocab/_Concept_warehouses
<http://www.semanticarts.com/vocab/_Concept_warehouses> rdf:type owl:NamedIndividual ,
                                                                 skos:Concept ;
                                                        skos:definition "A copy of the operational data of a firm, stored to optimize analytic retrieval instead of updates. Also organized to be robust in regard to changes in the structure of the operational databases or the hierarchical rollups of the dimensions." ;
                                                        skos:inScheme <http://www.semanticarts.com/vocab/_Domain_database> ;
                                                        skos:prefLabel "warehouses" .


###  http://www.semanticarts.com/vocab/_Concept_wellformedness
<http://www.semanticarts.com/vocab/_Concept_wellformedness> rdf:type owl:NamedIndividual ,
                                                                     skos:Concept ;
                                                            skos:definition "Property that a given tagged document adheres to the rules of documents of that type (e.g., all the tags match). Does not require a schema. See validation. Note that most HTML tools and browsers have become slack on well formedness, to the point where one cannot rely on HTML tags matching." ;
                                                            skos:inScheme <http://www.semanticarts.com/vocab/_Domain_XML,HTML> ;
                                                            skos:prefLabel "well formedness" .


