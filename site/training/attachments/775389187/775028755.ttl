@prefix : <http://example.org/orgs#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix orgs: <http://example.org/orgs/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix people: <http://example.org/people/> .
@base <http://example.org/orgs> .

<http://example.org/orgs> rdf:type owl:Ontology ;
                           owl:imports <http://example.org/people> ;
                           rdfs:comment "Test ontology about organizations" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/orgs/hasMember
orgs:hasMember rdf:type owl:ObjectProperty ;
               rdfs:label "Has Member" .


#################################################################
#    Classes
#################################################################

###  http://example.org/orgs/Organization
orgs:Organization rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty orgs:hasMember ;
                                    owl:someValuesFrom people:Person
                                  ] ;
                  rdfs:label "Organization" .


