#    Object Properties
#
#################################################################


###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/iAmMyOwnInverse

bugs:iAmMyOwnInverse rdf:type owl:ObjectProperty ;
                     
                     owl:inverseOf bugs:iAmMyOwnInverse .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/iAmSymmetric

bugs:iAmSymmetric rdf:type owl:ObjectProperty ,
                           owl:SymmetricProperty ;
                  
                  rdfs:domain bugs:ClassOne ;
                  
                  rdfs:range bugs:ClassTwo .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/iAmSymmetricWithDifferentDomainAndRange

bugs:iAmSymmetricWithDifferentDomainAndRange rdf:type owl:ObjectProperty ;
                                             
                                             rdfs:domain bugs:ClassOne ;
                                             
                                             rdfs:range bugs:ClassTwo .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/iAmTransitive

bugs:iAmTransitive rdf:type owl:ObjectProperty ,
                            owl:TransitiveProperty ;
                   
                   rdfs:domain bugs:ClassOne ;
                   
                   rdfs:range bugs:ClassTwo .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/iHaveTwoDistinctInverses

bugs:iHaveTwoDistinctInverses rdf:type owl:ObjectProperty ;
                              
                              owl:inverseOf bugs:inverseOne ,
                                            bugs:inverseTwo .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/inverseOne

bugs:inverseOne rdf:type owl:ObjectProperty .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/inverseTwo

bugs:inverseTwo rdf:type owl:ObjectProperty .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/pCrossedDomain

bugs:pCrossedDomain rdf:type owl:ObjectProperty ;
                    
                    rdfs:domain bugs:SubSubC .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/pCrossedRange

bugs:pCrossedRange rdf:type owl:ObjectProperty ;
                   
                   rdfs:range bugs:SubSubC .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/subPCrossedDomain

bugs:subPCrossedDomain rdf:type owl:ObjectProperty ;
                       
                       rdfs:domain bugs:C ;
                       
                       rdfs:subPropertyOf bugs:pCrossedDomain .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/subPCrossedRange

bugs:subPCrossedRange rdf:type owl:ObjectProperty ;
                      
                      rdfs:range bugs:SubC ;
                      
                      rdfs:subPropertyOf bugs:pCrossedRange .





