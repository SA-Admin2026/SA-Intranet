###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/C

bugs:C rdf:type owl:Class .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/ClassOne

bugs:ClassOne rdf:type owl:Class .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/ClassTwo

bugs:ClassTwo rdf:type owl:Class .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/SubC

bugs:SubC rdf:type owl:Class ;
          
          rdfs:subClassOf bugs:C .



###  http://ontologies.semanticarts.com/BuggyOntologyForTesting/SubSubC

bugs:SubSubC rdf:type owl:Class ;
             
             rdfs:subClassOf bugs:SubC .




