---
// Intranet home / launcher — a standalone page (not a Starlight doc) so it keeps the
// bespoke dark "console" header, status strip, and coming-soon previews. The section
// pages carry the Starlight chrome; this is the front door. Kept deliberately close to
// the original hand-built home, updated so the four migrated spaces show as live.
import fs from 'node:fs';
import path from 'node:path';
// Standalone page → not covered by Starlight's head; include the identity-aware nav here
// too so gated cards/links hide for users whose Entra groups don't allow them. Read from
// the project root (cwd) — a page module's import.meta.url points into the build output.
const identityNavScript = fs.readFileSync(
  path.resolve(process.cwd(), 'src/scripts/identity-nav.js'),
  'utf8'
);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Semantic Arts — Intranet</title>
<style is:global>
  :root{
    --blue:#005A7D; --blue-deep:#032C3D; --blue-2:#045B7B;
    --olive:#8C9E38; --gold:#D4A83A; --link:#1E70B0; --teal:#E0EEF2;
    --ink:#2B2B2B; --body:#4A4A4A; --muted:#808080; --rule:#d7e0e6; --page:#eef3f6; --panel:#fff;
    --sans:"Open Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    --mono:"SFMono-Regular",ui-monospace,Menlo,Consolas,monospace; --r:6px;
    --shadow:0 1px 2px rgba(3,44,61,.05),0 6px 20px rgba(3,44,61,.06);
  }
  @media (prefers-color-scheme:dark){:root{--page:#10151b;--panel:#182029;--ink:#e6edf3;--body:#aebcc7;--muted:#8ba0ad;--rule:#26303b;--teal:#12313d;}}
  *{box-sizing:border-box}
  /* Access-gated launcher links/cards start hidden; identity-nav reveals them when the
     user's Entra groups allow (or when not behind Access, e.g. local dev). No flash. */
  [data-gate]{display:none}
  body{margin:0;font-family:var(--sans);color:var(--body);background:var(--page);line-height:1.55}
  a{text-decoration:none;color:inherit}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .mono{font-family:var(--mono)}

  /* top nav */
  header.top{position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:16px;height:56px;padding:0 20px;
    background:linear-gradient(90deg,var(--blue-deep),var(--blue) 58%,var(--blue-2));border-bottom:2px solid var(--olive)}
  .logo{height:30px;display:block;flex:none}
  nav.main{display:flex;align-items:center;gap:2px;margin-left:6px;overflow-x:auto;scrollbar-width:none}
  nav.main::-webkit-scrollbar{display:none}
  nav.main a,nav.main span{font-size:13px;font-weight:600;color:rgba(255,255,255,.62);padding:7px 11px;border-radius:5px;white-space:nowrap}
  nav.main a.on{color:#fff;background:rgba(255,255,255,.10)}
  nav.main a.live:hover{color:#fff;background:rgba(255,255,255,.08)}
  nav.main .soon{color:rgba(255,255,255,.34);cursor:default}
  nav.main .soon::after{content:"○";font-size:8px;vertical-align:super;margin-left:3px;color:var(--gold)}
  .cmd{margin-left:auto;display:flex;align-items:center;gap:8px;height:32px;padding:0 11px;min-width:190px;flex:none;
    background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);border-radius:var(--r);color:rgba(255,255,255,.5);font-family:var(--mono);font-size:11px}
  .me{display:flex;align-items:center;gap:8px;flex:none}
  .avatar{width:30px;height:30px;border-radius:50%;background:var(--olive);color:#04303f;display:grid;place-items:center;font-weight:800;font-size:12px}
  .me .role{font-family:var(--mono);font-size:9px;color:#04303f;background:var(--gold);border-radius:3px;padding:2px 6px;font-weight:700}

  /* status strip */
  .strip{display:flex;align-items:center;gap:16px;height:28px;padding:0 20px;background:var(--blue-deep);color:#bcd3dc;font-family:var(--mono);font-size:11px;border-bottom:1px solid #0a4a63;overflow-x:auto;white-space:nowrap}
  .strip .led{width:8px;height:8px;border-radius:50%;background:var(--olive);box-shadow:0 0 0 3px rgba(140,158,56,.25);display:inline-block;margin-right:6px}
  .strip b{color:#fff}.strip .sep{color:#3f6b7d}

  .wrap{max-width:1200px;margin:20px auto;padding:0 20px;display:grid;grid-template-columns:1fr 300px;gap:18px}
  @media (max-width:900px){.wrap{grid-template-columns:1fr}}
  h2.sec{font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:2px 0 12px}
  .kick{font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--olive)}

  /* hero band */
  .hero{grid-column:1/-1;background:linear-gradient(120deg,var(--blue-deep),var(--blue) 78%);color:#fff;border-radius:10px;padding:24px 26px;position:relative;overflow:hidden;box-shadow:var(--shadow)}
  .hero .glow{position:absolute;right:-90px;top:-110px;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle,rgba(140,158,56,.30),transparent 62%)}
  .hero h1{margin:6px 0 4px;font-size:24px;font-weight:800;position:relative}
  .hero p{margin:0;color:rgba(255,255,255,.82);font-weight:300;max-width:640px;position:relative}
  .hero .vm{display:grid;grid-template-columns:1fr 1fr;gap:14px 28px;margin:14px 0 2px;position:relative}
  @media (max-width:640px){.hero .vm{grid-template-columns:1fr}}
  .vm-label{display:block;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--olive);margin-bottom:3px}
  .vm-item p{font-size:15px;font-weight:400;color:#fff;line-height:1.5;max-width:none}
  .values{margin-top:16px;position:relative}
  .values-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px 28px;margin-top:8px}
  @media (max-width:640px){.values-grid{grid-template-columns:1fr}}
  .val b{display:block;color:#fff;font-size:13.5px;font-weight:700;margin-bottom:2px}
  .val span{display:block;color:rgba(255,255,255,.75);font-size:12px;line-height:1.45}

  /* live section cards */
  .cards{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media (max-width:640px){.cards{grid-template-columns:1fr}}
  .card{display:block;background:var(--panel);border:1px solid var(--rule);border-radius:var(--r);box-shadow:var(--shadow);padding:18px;position:relative;transition:.14s}
  .card.live:hover{transform:translateY(-2px);border-color:var(--blue)}
  .card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;border-radius:var(--r) 0 0 var(--r);background:var(--blue)}
  .card .em{font-size:22px}
  .card h3{margin:8px 0 4px;font-size:17px;color:var(--ink)}
  .card p{margin:0;font-size:13.5px;color:var(--body)}
  .badge{position:absolute;top:14px;right:14px;font-family:var(--mono);font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:2px 7px;border-radius:4px}
  .b-live{color:#3f5016;background:rgba(140,158,56,.18)}
  .go{display:inline-block;margin-top:11px;font-weight:700;font-size:13px;color:var(--link)}
  .card.live .go::after{content:" →"}

  /* readable "coming soon" previews — show what's next, clearly not live */
  .preview{position:relative;background:var(--panel);border:1px dashed var(--rule);border-radius:var(--r);box-shadow:var(--shadow);padding:14px 16px;margin-bottom:14px;pointer-events:none}
  .preview .soon{position:absolute;top:12px;right:12px;font-family:var(--mono);font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#7a5a10;background:rgba(212,168,58,.20);border:1px solid rgba(212,168,58,.5);border-radius:20px;padding:3px 9px}
  @media (prefers-color-scheme:dark){.preview .soon{color:var(--gold)}}
  .preview .ph{font-size:12px;font-weight:800;color:var(--ink);margin:0 0 4px;text-transform:uppercase;letter-spacing:.05em}
  .preview .note{font-size:11px;color:var(--muted);font-style:italic;margin:10px 0 0}
  .feed{display:flex;gap:10px;padding:9px 0;border-top:1px solid var(--rule);opacity:.82}
  .feed:first-of-type{border-top:0}
  .feed .ic{font-size:16px;flex:none;width:22px;text-align:center}
  .feed .ft{font-size:11px;font-weight:700;color:var(--muted);font-family:var(--mono)}
  .feed .fh{font-size:13.5px;color:var(--ink);margin:1px 0 0}
  .newpill{font-family:var(--mono);font-size:9px;color:#3f5016;background:rgba(140,158,56,.16);border-radius:3px;padding:0 5px;margin-left:6px}

  /* right rail (future shape, blurred) */
  .previewwrap{position:relative;margin-top:6px}
  .previewwrap .lock{position:absolute;inset:0;display:grid;place-items:center;z-index:2;pointer-events:none}
  .previewwrap .lock span{font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:.04em;color:var(--muted);background:var(--panel);border:1px solid var(--rule);border-radius:20px;padding:6px 14px;box-shadow:var(--shadow)}
  .blur{filter:blur(3px);opacity:.55;pointer-events:none;user-select:none}
  .panel{background:var(--panel);border:1px solid var(--rule);border-radius:var(--r);box-shadow:var(--shadow);padding:14px;margin-bottom:14px}
  .phead{font-size:12px;font-weight:800;color:var(--ink);margin:0 0 10px}
  .ev{display:flex;gap:10px;padding:7px 0;border-top:1px solid var(--rule);font-size:13px}.ev:first-child{border-top:0}
  .ev b{color:var(--blue);font-family:var(--mono)}
  .tiles{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .tl{border:1px solid var(--rule);border-radius:5px;padding:10px;min-height:56px}
  .line{height:9px;border-radius:5px;background:var(--teal);margin:4px 0}
  .line.s{width:55%}.line.m{width:80%}

  .foot{background:var(--blue-deep);color:#9fc0cc;text-align:center;padding:14px;font-family:var(--mono);font-size:10.5px;margin-top:26px}
  .foot .o{color:var(--olive)}
  .legend{max-width:1200px;margin:0 auto;padding:2px 20px 0;font-size:11.5px;color:var(--muted)}
</style>
</head>
<body>
<p class="sr-only">Semantic Arts intranet home. Six sections are live; company news, team spaces, and the app launcher are shown as coming soon.</p>

<header class="top">
  <svg class="logo" viewBox="0 0 226 34" role="img" aria-label="semantic arts.">
    <g fill="none" stroke="#fff" stroke-width="1.1" opacity=".55">
      <circle cx="5" cy="9" r="2.1"/><circle cx="12" cy="9" r="2.1"/><circle cx="19" cy="9" r="2.1"/><circle cx="26" cy="9" r="2.1"/><circle cx="40" cy="9" r="2.1"/>
      <circle cx="5" cy="17" r="2.1"/><circle cx="12" cy="17" r="2.1"/><circle cx="19" cy="17" r="2.1"/><circle cx="26" cy="17" r="2.1"/><circle cx="33" cy="17" r="2.1"/><circle cx="40" cy="17" r="2.1"/>
      <circle cx="5" cy="25" r="2.1"/><circle cx="12" cy="25" r="2.1"/><circle cx="19" cy="25" r="2.1"/><circle cx="26" cy="25" r="2.1"/><circle cx="33" cy="25" r="2.1"/><circle cx="40" cy="25" r="2.1"/>
    </g>
    <g stroke="#8C9E38" stroke-width="2.4" stroke-linecap="round"><line x1="33" y1="9" x2="40" y2="9"/><line x1="33" y1="9" x2="30" y2="17"/><line x1="30" y1="17" x2="36" y2="25"/></g>
    <g fill="#8C9E38"><circle cx="33" cy="9" r="2.9"/><circle cx="40" cy="9" r="2.9"/><circle cx="30" cy="17" r="2.9"/><circle cx="36" cy="25" r="2.9"/></g>
    <text x="54" y="23" font-family="Open Sans,Segoe UI,Helvetica,Arial,sans-serif" font-size="19" font-weight="800" letter-spacing="-.3" fill="#fff">semantic arts<tspan fill="#8C9E38">.</tspan></text>
  </svg>
  <nav class="main">
    <a class="on" href="/">Home</a>
    <a class="live" href="/operations-manual/">Ops Manual</a>
    <a class="live" href="/reference/">Reference</a>
    <a class="live" href="/training/">Training</a>
    <a class="live" href="/administrative/">Administrative</a>
    <a class="live" href="/offerings/">Offerings</a>
    <a class="live" href="/internal-systems/">Internal Systems</a>
    <a class="live" href="/data-centric-architecture/">Data-Centric</a>
    <a class="live" href="/operations/" data-gate="/operations/">Operations</a>
    <span class="soon">News</span>
    <span class="soon">Apps</span>
  </nav>
  <div class="cmd">🔎 <span>search…</span></div>
  <div class="me"><span class="avatar">SA</span><span class="role">GATED · PREVIEW</span></div>
</header>

<div class="strip">
  <span><span class="led"></span><b>preview</b></span><span class="sep">|</span>
  <span>access: <b>gated</b></span><span class="sep">·</span>
  <span>sections_live: <b>7</b></span><span class="sep">·</span>
  <span>migrating out of Confluence · more coming</span>
</div>

<div class="wrap">
  <div class="hero"><div class="glow"></div>
    <div class="kick">Welcome</div>
    <h1>Semantic Arts</h1>
    <div class="vm">
      <div class="vm-item">
        <span class="vm-label">Our Vision</span>
        <p>A world where enterprise information is widely understood and easily accessed by all who have permission.</p>
      </div>
      <div class="vm-item">
        <span class="vm-label">Our Mission</span>
        <p>To lead as many firms as possible on their journey to a data-centric future.</p>
      </div>
    </div>
    <div class="values">
      <span class="vm-label">Our Values</span>
      <div class="values-grid">
        <div class="val"><b>Create Value</b><span>All our projects should be creating value for our clients. We are not trying to set up situations where our clients pay us because we have coerced them or made them dependent on us.</span></div>
        <div class="val"><b>One Voice</b><span>We can disagree violently in the office but will present our best consensus when we are with the client.</span></div>
        <div class="val"><b>Share Equitably</b><span>We focus on ways to share the results of our efforts with our clients, our partners, and our employees. Equitable sharing is based on contribution.</span></div>
        <div class="val"><b>Lifetime Learning</b><span>We value continual study and research to look for better ways, and to stay current in our discipline, rather than milking whatever expertise we have.</span></div>
        <div class="val"><b>Show Respect</b><span>While focusing on results we need to remain mindful of the contribution, options, and rights of others. In all our dealings we need to be humble.</span></div>
        <div class="val"><b>Have Fun</b><span>We are not here to suffer for the sake of the firm. We can accomplish all we set out to, stay true to our values, still have a good time, and take time off to enjoy our outside lives.</span></div>
      </div>
    </div>
  </div>

  <!-- MAIN COLUMN -->
  <main>
    <h2 class="sec">📣 Company news</h2>
    <div class="preview">
      <span class="soon">Preview · not live yet</span>
      <div class="feed"><div class="ic">📢</div><div><div class="ft">Announcement · Amanda R.</div><div class="fh">We're moving payroll to Paylocity — what's changing and when</div></div></div>
      <div class="feed"><div class="ic">👋</div><div><div class="ft">People · HR</div><div class="fh">Welcome — two new colleagues joining this month</div></div></div>
      <div class="feed"><div class="ic">🗓️</div><div><div class="ft">Firm · Exec team</div><div class="fh">Strategic planning offsite — Oct 12–13</div></div></div>
      <p class="note">Example content. Firm announcements and news will post here.</p>
    </div>

    <h2 class="sec" style="margin-top:26px">Available now</h2>
    <div class="cards">
      <a class="card live" href="/operations-manual/">
        <span class="badge b-live">Live</span>
        <span class="em">🗂️</span>
        <h3>Operations Manual</h3>
        <p>The firm's operating procedures and practice-management guides — management, accounting, and HR — fully searchable.</p>
        <span class="go">Open the Operations Manual</span>
      </a>
      <a class="card live" href="/reference/">
        <span class="badge b-live">Live</span>
        <span class="em">📘</span>
        <h3>Reference</h3>
        <p>The employee reference library — handbook (with state addenda), employment agreement, and the company reference guide. Verbatim and searchable.</p>
        <span class="go">Open Reference</span>
      </a>
      <a class="card live" href="/training/">
        <span class="badge b-live">Live</span>
        <span class="em">🎓</span>
        <h3>Training / LMS</h3>
        <p>Onboarding and ontology / knowledge-graph training, organized by learning path, with an interactive knowledge map.</p>
        <span class="go">Open Training</span>
      </a>
      <a class="card live" href="/administrative/">
        <span class="badge b-live">Live</span>
        <span class="em">🏢</span>
        <h3>Administrative</h3>
        <p>HR, marketing &amp; sales, the company reference guide, and firm summits — the day-to-day administrative record.</p>
        <span class="go">Open Administrative</span>
      </a>
      <a class="card live" href="/offerings/">
        <span class="badge b-live">Live</span>
        <span class="em">🎯</span>
        <h3>Offerings</h3>
        <p>What we offer clients — services, the gist ontology tooling, and how we run engagements.</p>
        <span class="go">Open Offerings</span>
      </a>
      <a class="card live" href="/internal-systems/">
        <span class="badge b-live">Live</span>
        <span class="em">🛠️</span>
        <h3>Internal Systems</h3>
        <p>The tools and systems that run the business — how-tos, integrations, and operational reference.</p>
        <span class="go">Open Internal Systems</span>
      </a>
      <a class="card live" href="/data-centric-architecture/">
        <span class="badge b-live">Live</span>
        <span class="em">🧠</span>
        <h3>Data-Centric Architecture</h3>
        <p>The ideas at the core of our practice — the layers of the DCA and the thinking behind them.</p>
        <span class="go">Open Data-Centric Architecture</span>
      </a>
      <a class="card live" href="/operations/" data-gate="/operations/">
        <span class="badge b-live">Ops team</span>
        <span class="em">⚙️</span>
        <h3>Operations</h3>
        <p>The operations team's workspace. Access-controlled — visible to the operations team (pilot for role-based gating).</p>
        <span class="go">Open Operations</span>
      </a>
    </div>

    <h2 class="sec" style="margin-top:26px">Coming soon — a preview of what's next</h2>

    <div class="preview">
      <span class="soon">Preview · not live yet</span>
      <div class="ph">🧠 Weekly intelligence briefs</div>
      <div class="feed"><div class="ic">🛡️</div><div><div class="ft">IT Security</div><div class="fh">“Consent is the new perimeter” — spotting OAuth-consent phishing<span class="newpill">new</span></div></div></div>
      <div class="feed"><div class="ic">🤖</div><div><div class="ft">AI &amp; Data Trends</div><div class="fh">Semantic layers converge on MCP as the agent interface</div></div></div>
      <div class="feed"><div class="ic">📣</div><div><div class="ft">Marketing</div><div class="fh">Competitors adopt our “explainable, governed AI” language</div></div></div>
      <div class="feed"><div class="ic">⚖️</div><div><div class="ft">HR Compliance</div><div class="fh">Virginia expands its non-compete limits</div></div></div>
      <div class="feed"><div class="ic">📈</div><div><div class="ft">General Business</div><div class="fh">Fed holds — the market now prices a September hike</div></div></div>
      <div class="feed"><div class="ic">📅</div><div><div class="ft">Conferences &amp; Events</div><div class="fh">KMWorld &amp; DGIQ East land the same week — pick one</div></div></div>
      <div class="feed"><div class="ic">🏆</div><div><div class="ft">Awards</div><div class="fh">KMWorld “100 Companies That Matter in KM” — free, on-brand</div></div></div>
      <p class="note">A preview of the weekly COO intelligence briefs (IT, AI/data, marketing, HR, business, conferences, awards). These will surface here each week.</p>
    </div>

    <p class="legend">Handbook &amp; HR, role/project-gated team spaces, and the app launcher (COO OS, hiring, analytics) are also on the way.</p>
  </main>

  <!-- RIGHT RAIL (future shape, blurred) -->
  <aside>
    <h2 class="sec">Your workspace</h2>
    <div class="previewwrap">
      <div class="lock"><span>🔒 Coming soon</span></div>
      <div class="blur">
        <div class="panel"><div class="phead">📅 Your day</div>
          <div class="ev"><b>09:30</b><div>Team sync</div></div><div class="ev"><b>11:00</b><div>Project review</div></div><div class="ev"><b>14:00</b><div>1:1</div></div>
        </div>
        <div class="panel"><div class="phead">🚀 Your apps</div>
          <div class="tiles"><div class="tl"></div><div class="tl"></div><div class="tl"></div><div class="tl"></div></div>
        </div>
        <div class="panel"><div class="phead">🔗 Quick links</div><div class="line m"></div><div class="line s"></div><div class="line m"></div><div class="line s"></div></div>
      </div>
    </div>
  </aside>
</div>

<div class="foot">© Semantic Arts, Inc. &nbsp;|&nbsp; semanticarts<span class="o">.</span>com &nbsp;|&nbsp; internal intranet · preview · logo placeholder pending official asset</div>
<script is:inline set:html={identityNavScript}></script>
</body>
</html>
