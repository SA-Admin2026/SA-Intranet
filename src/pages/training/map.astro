---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { buildGraph, CAT_COLOR, CATEGORY_ORDER } from '../../lib/training-graph';

const g = buildGraph();
const nodes = g.nodes.filter((n) => n.deg > 0);
const data = {
  nodes: nodes.map((n) => ({ id: n.id, title: n.title, category: n.category, color: n.color, val: 2 + n.deg })),
  links: g.edges,
};
const cats = CATEGORY_ORDER.filter((c) => nodes.some((n) => n.category === c));
---

<StarlightPage
  frontmatter={{
    title: 'Knowledge map',
    description:
      'How the training topics connect — the cross-references carried over from Confluence, now navigable.',
    tableOfContents: false,
  }}
>
  <p>
    Every line is a cross-reference between two lessons — the connective tissue that was invisible in
    Confluence, now structured data we can render and navigate. <strong>{nodes.length}</strong> connected
    lessons, <strong>{g.edges.length}</strong> links. Drag to explore, scroll to zoom, and click a node to open the lesson.
  </p>

  <p class="kg-start">
    <strong>New here?</strong> Start with the
    <a href="/training/new-ontologist-orientation/">New ontologist orientation</a> path
    — its lessons are ringed and labelled on the map (blue, “Start here”).
  </p>

  <div class="kg-legend">
    {cats.map((c) => (
      <span class="kg-key"><span class="kg-dot" style={`background:${CAT_COLOR[c]}`}></span>{c}</span>
    ))}
  </div>

  <div id="kg"></div>

  <script id="kg-data" type="application/json" set:html={JSON.stringify(data)}></script>
  <script>
    import ForceGraph from 'force-graph';
    const el = document.getElementById('kg')!;
    const data = JSON.parse(document.getElementById('kg-data')!.textContent!);
    const width = () => el.clientWidth || 760;
    const radius = (n: any) => Math.sqrt(n.val) * 1.7;
    const isStart = (n: any) => n.category === 'Start here';
    const labelColor = () =>
      document.documentElement.dataset.theme === 'dark' ? '#e5e7eb' : '#3d3d3a';

    const graph = (ForceGraph as any)()(el)
      .graphData(data)
      .nodeId('id')
      .nodeLabel((n: any) => n.title)
      .linkColor(() => 'rgba(130,130,140,0.22)')
      .linkWidth(0.6)
      // Node ids are already full /training/… routes → navigate directly.
      .onNodeClick((n: any) => { window.location.href = n.id; })
      .nodeCanvasObject((n: any, ctx: any, scale: number) => {
        const r = radius(n);
        ctx.beginPath(); ctx.arc(n.x, n.y, r, 0, 2 * Math.PI);
        ctx.fillStyle = n.color; ctx.fill();
        if (isStart(n)) {
          ctx.lineWidth = 2 / scale; ctx.strokeStyle = '#3358cc';
          ctx.beginPath(); ctx.arc(n.x, n.y, r + 3 / scale, 0, 2 * Math.PI); ctx.stroke();
        }
        if ((isStart(n) || n.val >= 9) && scale > 0.55) {
          const fs = 11 / scale;
          ctx.font = `${isStart(n) ? '600 ' : ''}${fs}px sans-serif`;
          ctx.textAlign = 'center'; ctx.textBaseline = 'top';
          ctx.fillStyle = isStart(n) ? '#3358cc' : labelColor();
          ctx.fillText(n.title.length > 34 ? n.title.slice(0, 33) + '…' : n.title, n.x, n.y + r + 2 / scale);
        }
      })
      .nodePointerAreaPaint((n: any, color: string, ctx: any) => {
        ctx.fillStyle = color;
        ctx.beginPath(); ctx.arc(n.x, n.y, radius(n) + 3, 0, 2 * Math.PI); ctx.fill();
      })
      .width(width())
      .height(560);
    graph.d3VelocityDecay(0.3);
    addEventListener('resize', () => graph.width(width()));
  </script>
</StarlightPage>

<style>
  #kg { height: 560px; border: 1px solid var(--sl-color-hairline); border-radius: 12px; overflow: hidden; background: var(--sl-color-bg); }
  .kg-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0 0 12px; font-size: 0.85rem; }
  .kg-key { display: inline-flex; align-items: center; gap: 6px; color: var(--sl-color-gray-2); }
  .kg-dot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
</style>
