---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

// Interactive SPARQL curriculum hub. A real SPARQL 1.1 engine (Oxigraph → WASM) runs in
// the browser over a small in-memory "firm" dataset — no server — so learners read, then
// practise with live, auto-checked exercises grouped into three levels. Each exercise is
// graded by running the learner's query and a reference solution and comparing result sets.

const PREFIXES = `PREFIX ex: <https://example.org/firm#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
`;

const DATASET = `${PREFIXES}
ex:ada     a ex:Person ; rdfs:label "Ada Lovelace"    ; ex:role "Ontologist" ; ex:joined 2019 ; ex:skill "SPARQL", "OWL"    ; ex:worksOn ex:atlas, ex:beacon ; ex:reportsTo ex:edsger .
ex:grace   a ex:Person ; rdfs:label "Grace Hopper"    ; ex:role "Developer"  ; ex:joined 2021 ; ex:skill "Python", "SPARQL" ; ex:worksOn ex:beacon          ; ex:reportsTo ex:ada .
ex:alan    a ex:Person ; rdfs:label "Alan Turing"     ; ex:role "Consultant" ; ex:joined 2020 ; ex:skill "OWL", "SHACL"     ; ex:worksOn ex:atlas, ex:cobalt ; ex:reportsTo ex:edsger .
ex:barbara a ex:Person ; rdfs:label "Barbara Liskov"  ; ex:role "Developer"  ; ex:joined 2022 ; ex:skill "Python"           ; ex:worksOn ex:cobalt          ; ex:reportsTo ex:ada .
ex:edsger  a ex:Person ; rdfs:label "Edsger Dijkstra" ; ex:role "Partner"    ; ex:joined 2015 .

ex:atlas   a ex:Project ; rdfs:label "Atlas"  ; ex:client "Northwind" ; ex:budget 500000 .
ex:beacon  a ex:Project ; rdfs:label "Beacon" ; ex:client "Contoso"   ; ex:budget 250000 .
ex:cobalt  a ex:Project ; rdfs:label "Cobalt" ; ex:client "Northwind" ; ex:budget 750000 .
`;

const q = (select, body) => `${PREFIXES}\nSELECT ${select} WHERE {\n${body}\n}`;

// group = which of the three levels; solution is used only to grade the learner's answer.
const EXERCISES = [
  // ---- Level 1 --------------------------------------------------------------
  {
    id: 'select-all', group: 'Basics', title: 'Select every person', concept: 'Triple patterns',
    prompt: 'Return the name of every <code>ex:Person</code>. One column: <code>?name</code>.',
    hint: 'Match `?p a ex:Person` and `?p rdfs:label ?name`.',
    starter: q('?name', '  # every ?p that is an ex:Person; bind its rdfs:label to ?name\n  '),
    solution: `${PREFIXES} SELECT ?name WHERE { ?p a ex:Person ; rdfs:label ?name }`,
  },
  {
    id: 'developers', group: 'Basics', title: 'Filter by role', concept: 'Matching a literal',
    prompt: 'Return the <code>?name</code> of every person whose <code>ex:role</code> is <code>"Developer"</code>.',
    hint: 'Add a predicate on the same subject: `?p ex:role "Developer"`.',
    starter: q('?name', '  '),
    solution: `${PREFIXES} SELECT ?name WHERE { ?p ex:role "Developer" ; rdfs:label ?name }`,
  },
  {
    id: 'joined-after', group: 'Basics', title: 'FILTER on a number', concept: 'Numeric FILTER',
    prompt: 'Return the <code>?name</code> of everyone who joined <strong>after 2020</strong> (<code>ex:joined</code> &gt; 2020).',
    hint: 'Bind the year to `?y`, then `FILTER(?y > 2020)`.',
    starter: q('?name', '  '),
    solution: `${PREFIXES} SELECT ?name WHERE { ?p rdfs:label ?name ; ex:joined ?y FILTER(?y > 2020) }`,
  },
  {
    id: 'person-skill', group: 'Basics', title: 'One row per value', concept: 'Multi-valued properties',
    prompt: 'Return every person&rsquo;s <code>?name</code> and each of their <code>?skill</code>s. People with several skills appear on several rows.',
    hint: 'A subject with two `ex:skill` values yields two rows automatically.',
    starter: q('?name ?skill', '  '),
    solution: `${PREFIXES} SELECT ?name ?skill WHERE { ?p rdfs:label ?name ; ex:skill ?skill }`,
  },
  // ---- Level 2 --------------------------------------------------------------
  {
    id: 'distinct-skills', group: 'Sets, optionals & aggregates', title: 'DISTINCT values', concept: 'SELECT DISTINCT',
    prompt: 'Return the <strong>distinct</strong> set of <code>?skill</code>s that appear anywhere in the firm.',
    hint: 'Without DISTINCT, "Python" and "SPARQL" repeat. Add `DISTINCT`.',
    starter: q('?skill', '  '),
    solution: `${PREFIXES} SELECT DISTINCT ?skill WHERE { ?p ex:skill ?skill }`,
  },
  {
    id: 'optional-skill', group: 'Sets, optionals & aggregates', title: 'OPTIONAL — keep the unmatched', concept: 'OPTIONAL',
    prompt: 'Return every person&rsquo;s <code>?name</code> and their <code>?skill</code> <strong>if they have one</strong> — but include people with no skills too (there is one).',
    hint: 'Wrap the skill pattern in `OPTIONAL { ... }` so Edsger still appears.',
    starter: `${PREFIXES}\nSELECT ?name ?skill WHERE {\n  ?p a ex:Person ; rdfs:label ?name\n  \n}`,
    solution: `${PREFIXES} SELECT ?name ?skill WHERE { ?p a ex:Person ; rdfs:label ?name OPTIONAL { ?p ex:skill ?skill } }`,
  },
  {
    id: 'count-projects', group: 'Sets, optionals & aggregates', title: 'GROUP BY and COUNT', concept: 'Aggregation',
    prompt: 'For each person who works on a project, return their <code>?name</code> and the number of projects as <code>?n</code>.',
    hint: 'Bind projects with `ex:worksOn`, `GROUP BY ?name`, and `(COUNT(?proj) AS ?n)`.',
    starter: `${PREFIXES}\nSELECT ?name (COUNT(?proj) AS ?n) WHERE {\n  \n}\nGROUP BY ?name`,
    solution: `${PREFIXES} SELECT ?name (COUNT(?proj) AS ?n) WHERE { ?p rdfs:label ?name ; ex:worksOn ?proj } GROUP BY ?name`,
  },
  {
    id: 'most-recent', group: 'Sets, optionals & aggregates', title: 'ORDER BY and LIMIT', concept: 'Sorting & top-N',
    prompt: 'Return the <code>?name</code> of the <strong>two most recently joined</strong> people.',
    hint: 'Bind `ex:joined ?y`, then `ORDER BY DESC(?y)` and `LIMIT 2`.',
    starter: `${PREFIXES}\nSELECT ?name WHERE {\n  \n}\n# ORDER BY ... LIMIT ...`,
    solution: `${PREFIXES} SELECT ?name WHERE { ?p rdfs:label ?name ; ex:joined ?y } ORDER BY DESC(?y) LIMIT 2`,
  },
  {
    id: 'roles-having', group: 'Sets, optionals & aggregates', title: 'HAVING — filter the groups', concept: 'HAVING',
    prompt: 'Return each <code>?role</code> held by <strong>more than one</strong> person, with the count as <code>?n</code>.',
    hint: 'Group by `?role`, then `HAVING(COUNT(?p) > 1)`.',
    starter: `${PREFIXES}\nSELECT ?role (COUNT(?p) AS ?n) WHERE {\n  \n}\nGROUP BY ?role`,
    solution: `${PREFIXES} SELECT ?role (COUNT(?p) AS ?n) WHERE { ?p ex:role ?role } GROUP BY ?role HAVING(COUNT(?p) > 1)`,
  },
  // ---- Level 3 --------------------------------------------------------------
  {
    id: 'northwind', group: 'Graph patterns & advanced', title: 'Join across the graph', concept: 'Joining entity types',
    prompt: 'Return the distinct <code>?name</code> of everyone who works on a project whose <code>ex:client</code> is <code>"Northwind"</code>.',
    hint: 'Go person → `ex:worksOn` → project, then project → `ex:client` "Northwind".',
    starter: q('DISTINCT ?name', '  '),
    solution: `${PREFIXES} SELECT DISTINCT ?name WHERE { ?p rdfs:label ?name ; ex:worksOn ?proj . ?proj ex:client "Northwind" }`,
  },
  {
    id: 'path-clients', group: 'Graph patterns & advanced', title: 'Property path', concept: 'Path (a/b)',
    prompt: 'Using a <strong>property path</strong>, return the distinct <code>?client</code> names that <code>ex:ada</code> serves — hop <code>ex:worksOn</code> then <code>ex:client</code> in one step.',
    hint: 'A path chains predicates: `ex:ada ex:worksOn/ex:client ?client`.',
    starter: q('DISTINCT ?client', '  '),
    solution: `${PREFIXES} SELECT DISTINCT ?client WHERE { ex:ada ex:worksOn/ex:client ?client }`,
  },
  {
    id: 'path-managers', group: 'Graph patterns & advanced', title: 'Transitive path', concept: 'Path (+)',
    prompt: 'Return the <code>?name</code> of everyone <code>ex:grace</code> reports to <strong>directly or indirectly</strong>, up the whole chain.',
    hint: 'The `+` path means "one or more hops": `ex:grace ex:reportsTo+ ?m`.',
    starter: `${PREFIXES}\nSELECT ?name WHERE {\n  \n}`,
    solution: `${PREFIXES} SELECT ?name WHERE { ex:grace ex:reportsTo+ ?m . ?m rdfs:label ?name }`,
  },
  {
    id: 'subquery-budget', group: 'Graph patterns & advanced', title: 'Subquery', concept: 'Nested SELECT',
    prompt: 'Return the distinct <code>?name</code> of everyone who works on the <strong>single highest-budget</strong> project. Use a subquery to find the max <code>ex:budget</code>.',
    hint: 'Inner: `{ SELECT (MAX(?bb) AS ?maxb) WHERE { ?x ex:budget ?bb } }`, then match projects with that budget.',
    starter: `${PREFIXES}\nSELECT DISTINCT ?name WHERE {\n  ?p rdfs:label ?name ; ex:worksOn ?proj .\n  ?proj ex:budget ?b .\n  # subquery for the max budget, then FILTER(?b = ?maxb)\n  \n}`,
    solution: `${PREFIXES} SELECT DISTINCT ?name WHERE { ?p rdfs:label ?name ; ex:worksOn ?proj . ?proj ex:budget ?b . { SELECT (MAX(?bb) AS ?maxb) WHERE { ?x ex:budget ?bb } } FILTER(?b = ?maxb) }`,
  },
  {
    id: 'no-skills', group: 'Graph patterns & advanced', title: 'Negation', concept: 'MINUS / NOT EXISTS',
    prompt: 'Return the <code>?name</code> of every person who has <strong>no recorded skill</strong>.',
    hint: 'Match all people, then `MINUS { ?p ex:skill ?s }` (or `FILTER NOT EXISTS { ... }`).',
    starter: q('?name', '  ?p a ex:Person ; rdfs:label ?name\n  '),
    solution: `${PREFIXES} SELECT ?name WHERE { ?p a ex:Person ; rdfs:label ?name MINUS { ?p ex:skill ?s } }`,
  },
  {
    id: 'bind-tenure', group: 'Graph patterns & advanced', title: 'BIND an expression', concept: 'BIND / computed values',
    prompt: 'Return each person&rsquo;s <code>?name</code> and their <code>?tenure</code> in years (as of 2026), for anyone with <strong>at least 5 years</strong>.',
    hint: 'BIND the difference: `BIND(2026 - ?y AS ?tenure)`, then `FILTER(?tenure >= 5)`.',
    starter: `${PREFIXES}\nSELECT ?name ?tenure WHERE {\n  ?p rdfs:label ?name ; ex:joined ?y\n  \n}`,
    solution: `${PREFIXES} SELECT ?name ?tenure WHERE { ?p rdfs:label ?name ; ex:joined ?y BIND(2026 - ?y AS ?tenure) FILTER(?tenure >= 5) }`,
  },
];

const GROUPS = ['Basics', 'Sets, optionals & aggregates', 'Graph patterns & advanced'];

// "Read" — the reference lessons this hub practises. Links into the existing SPARQL pages.
const READING = [
  { title: 'SPARQL reference — overview', href: '/training/languages/sparql/' },
  { title: 'Generic queries for any store', href: '/training/languages/sparql/sparql-generic-queries-applicable-to-any-store/' },
  { title: 'Useful info, tips & tricks', href: '/training/languages/sparql/sparql-useful-info-tips-tricks/' },
  { title: 'SPARQL gotchas', href: '/training/languages/sparql/sparql-gotchas/' },
  { title: 'String functions', href: '/training/languages/sparql/sparql-string-functions/' },
  { title: 'Subqueries', href: '/training/languages/sparql/subqueries/' },
];

const payload = { dataset: DATASET, exercises: EXERCISES, groups: GROUPS };
---

<StarlightPage
  frontmatter={{
    title: 'SPARQL — learn & practice',
    description:
      'A hands-on SPARQL course: read the essentials, then write real queries against a live in-browser knowledge graph with auto-checked exercises.',
    tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
  }}
>
  <p>
    A working SPARQL 1.1 engine runs <strong>right here in your browser</strong> — no server, nothing to
    install — over a tiny knowledge graph about a fictional firm: its people, their roles and skills, and the
    projects and clients they work with. <strong>Read</strong> the essentials, then <strong>practise</strong>
    with {EXERCISES.length} auto-checked exercises that build from first triple patterns to property paths and
    subqueries.
  </p>

  <h2 id="learn">What you&rsquo;ll learn</h2>
  <ul>
    <li><strong>Basics</strong> — triple patterns, matching literals, numeric <code>FILTER</code>, multi-valued properties.</li>
    <li><strong>Sets, optionals &amp; aggregates</strong> — <code>DISTINCT</code>, <code>OPTIONAL</code>, <code>GROUP BY</code>/<code>COUNT</code>, <code>ORDER BY</code>/<code>LIMIT</code>, <code>HAVING</code>.</li>
    <li><strong>Graph patterns &amp; advanced</strong> — joins, property paths (including transitive <code>+</code>), subqueries, negation, and <code>BIND</code>.</li>
  </ul>

  <h2 id="read">Read first</h2>
  <p>Skim the reference pages behind these skills — then come back and practise:</p>
  <ul>
    {READING.map((r) => (<li><a href={r.href}>{r.title}</a></li>))}
  </ul>

  <details class="sl-dataset">
    <summary>The dataset — <span class="mono">firm.ttl</span> (Turtle)</summary>
    <p>Everything below is loaded into the graph. Keep it open as your reference while you query.</p>
    <pre class="ttl"><code set:html={payload.dataset}></code></pre>
  </details>

  <h2 id="practice">Practise</h2>
  <div id="sparql-lab" data-loading>
    <div class="lab-progress" hidden>
      <div class="lp-head"><strong>Your progress</strong><span id="lp-count">0 / {EXERCISES.length}</span></div>
      <div class="lp-bar"><div class="lp-fill" id="lp-fill" style="width:0%"></div></div>
    </div>
    <p class="lab-status" id="lab-status">Loading the SPARQL engine…</p>
    <div id="lab-exercises"></div>

    <h2 id="scratch">Scratch pad</h2>
    <p>A free query box — experiment with anything against the dataset above.</p>
    <div class="ex-card">
      <textarea class="q" id="scratch" spellcheck="false" rows="6">{`${PREFIXES}\nSELECT * WHERE { ?s ?p ?o } LIMIT 10`}</textarea>
      <div class="ex-actions"><button class="btn run" data-scratch>Run</button></div>
      <div class="ex-out" data-scratch-out></div>
    </div>

    <p class="lab-reset"><button class="btn ghost" id="reset-progress">Reset my progress</button></p>
  </div>

  <script type="application/json" id="lab-data" set:html={JSON.stringify(payload)}></script>

  <script>
    import init, { Store } from 'oxigraph/web.js';
    import wasmUrl from 'oxigraph/web_bg.wasm?url';

    const { dataset, exercises, groups } = JSON.parse(document.getElementById('lab-data')!.textContent!);
    const DONE_KEY = (id: string) => 'sat:sparql:' + id;

    function normalize(bindings: any[]): string {
      return JSON.stringify(
        bindings
          .map((b) => [...b.entries()].map(([k, v]: [string, any]) => `${k}=${v ? v.value : ''}`).sort().join(' | '))
          .sort()
      );
    }
    function runQuery(store: any, sparql: string) {
      const r = store.query(sparql);
      if (typeof r === 'boolean') return { kind: 'ask', value: r };
      const arr = [...r];
      if (arr.length && arr[0] && 'subject' in arr[0]) return { kind: 'graph', quads: arr };
      return { kind: 'select', bindings: arr };
    }
    function escapeHtml(s: string) {
      return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    }
    function renderResult(res: any): string {
      if (res.kind === 'ask') return `<p class="r-ask">ASK → <strong>${res.value}</strong></p>`;
      if (res.kind === 'graph') return `<p class="r-note">${res.quads.length} triple(s) constructed.</p>`;
      const rows = res.bindings;
      if (!rows.length) return `<p class="r-note">No results (0 rows).</p>`;
      const cols = [...new Set(rows.flatMap((b: any) => [...b.keys()]))];
      const head = cols.map((c) => `<th>${c}</th>`).join('');
      const body = rows
        .map((b: any) => '<tr>' + cols.map((c) => `<td>${b.get(c) ? escapeHtml(b.get(c).value) : ''}</td>`).join('') + '</tr>')
        .join('');
      return `<div class="r-wrap"><table class="r-table"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div><p class="r-count">${rows.length} row(s)</p>`;
    }

    (async () => {
      const statusEl = document.getElementById('lab-status')!;
      let store: any;
      try {
        await init(wasmUrl);
        store = new Store();
        store.load(dataset, { format: 'text/turtle' });
      } catch (e: any) {
        statusEl.textContent = 'Could not load the SPARQL engine: ' + (e?.message || e);
        return;
      }
      document.getElementById('sparql-lab')!.removeAttribute('data-loading');
      statusEl.remove();
      (document.querySelector('.lab-progress') as HTMLElement).hidden = false;

      const total = exercises.length;
      const updateProgress = () => {
        const done = exercises.filter((ex: any) => localStorage.getItem(DONE_KEY(ex.id)) === '1').length;
        document.getElementById('lp-count')!.textContent = `${done} / ${total}`;
        (document.getElementById('lp-fill') as HTMLElement).style.width = Math.round((100 * done) / total) + '%';
      };

      const wrap = document.getElementById('lab-exercises')!;
      groups.forEach((grp: string) => {
        const h = document.createElement('h3');
        h.className = 'lab-group';
        h.textContent = grp;
        wrap.appendChild(h);

        exercises.filter((e: any) => e.group === grp).forEach((ex: any) => {
          const n = exercises.indexOf(ex) + 1;
          const done = localStorage.getItem(DONE_KEY(ex.id)) === '1';
          const card = document.createElement('div');
          card.className = 'ex-card' + (done ? ' is-done' : '');
          card.innerHTML = `
            <div class="ex-head">
              <span class="ex-n">${n}</span>
              <div><h4 class="ex-title">${ex.title} <span class="ex-tick">✓</span></h4>
              <span class="ex-concept">${ex.concept}</span></div>
            </div>
            <p class="ex-prompt">${ex.prompt}</p>
            <textarea class="q" spellcheck="false" rows="7">${ex.starter}</textarea>
            <div class="ex-actions">
              <button class="btn run">Run</button>
              <button class="btn check">Check</button>
              <button class="btn ghost hint-btn">Hint</button>
              <span class="ex-verdict"></span>
            </div>
            <p class="ex-hint" hidden>${ex.hint}</p>
            <div class="ex-out"></div>`;
          wrap.appendChild(card);

          const ta = card.querySelector('textarea') as HTMLTextAreaElement;
          const out = card.querySelector('.ex-out') as HTMLElement;
          const verdict = card.querySelector('.ex-verdict') as HTMLElement;
          const safeRun = (sparql: string) => {
            try { return { ok: true, res: runQuery(store, sparql) }; }
            catch (e: any) { return { ok: false, err: e?.message || String(e) }; }
          };

          card.querySelector('.run')!.addEventListener('click', () => {
            verdict.textContent = '';
            const r = safeRun(ta.value);
            out.innerHTML = r.ok ? renderResult(r.res) : `<pre class="r-err">${escapeHtml(r.err)}</pre>`;
          });
          card.querySelector('.check')!.addEventListener('click', () => {
            const mine = safeRun(ta.value);
            if (!mine.ok) { out.innerHTML = `<pre class="r-err">${escapeHtml(mine.err)}</pre>`; verdict.className = 'ex-verdict bad'; verdict.textContent = '✗ query error'; return; }
            out.innerHTML = renderResult(mine.res);
            if (mine.res.kind !== 'select') { verdict.className = 'ex-verdict bad'; verdict.textContent = '✗ expected a SELECT query'; return; }
            const want = runQuery(store, ex.solution) as any;
            if (normalize(mine.res.bindings) === normalize(want.bindings)) {
              verdict.className = 'ex-verdict good'; verdict.textContent = '✓ correct';
              card.classList.add('is-done'); localStorage.setItem(DONE_KEY(ex.id), '1'); updateProgress();
            } else {
              verdict.className = 'ex-verdict bad'; verdict.textContent = `✗ not quite — expected ${want.bindings.length} row(s)`;
            }
          });
          card.querySelector('.hint-btn')!.addEventListener('click', () => {
            const hh = card.querySelector('.ex-hint') as HTMLElement; hh.hidden = !hh.hidden;
          });
        });
      });

      const scratch = document.getElementById('scratch') as HTMLTextAreaElement;
      const scratchOut = document.querySelector('[data-scratch-out]') as HTMLElement;
      document.querySelector('[data-scratch]')!.addEventListener('click', () => {
        try { scratchOut.innerHTML = renderResult(runQuery(store, scratch.value)); }
        catch (e: any) { scratchOut.innerHTML = `<pre class="r-err">${escapeHtml(e?.message || String(e))}</pre>`; }
      });
      document.getElementById('reset-progress')!.addEventListener('click', () => {
        exercises.forEach((ex: any) => localStorage.removeItem(DONE_KEY(ex.id)));
        document.querySelectorAll('.ex-card.is-done').forEach((c) => c.classList.remove('is-done'));
        document.querySelectorAll('.ex-verdict').forEach((v) => ((v as HTMLElement).textContent = ''));
        updateProgress();
      });

      updateProgress();
    })();
  </script>
</StarlightPage>

<style>
  .sl-dataset { margin: 1.25rem 0; border: 1px solid var(--sl-color-hairline); border-radius: 10px; padding: 0.5rem 1rem; }
  .sl-dataset summary { font-weight: 600; cursor: pointer; }
  .sl-dataset .ttl { max-height: 320px; overflow: auto; font-size: 0.82rem; }
  .lab-status { color: var(--sl-color-gray-2); font-style: italic; }

  .lab-progress { position: sticky; top: 0; z-index: 5; background: var(--sl-color-bg); padding: 0.6rem 0; margin-bottom: 0.5rem; }
  .lp-head { display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.35rem; }
  .lp-bar { height: 8px; border-radius: 999px; background: var(--sl-color-gray-6); overflow: hidden; }
  .lp-fill { height: 100%; background: var(--sa-olive, #8C9E38); border-radius: 999px; transition: width 0.3s ease; }
  .lab-group { margin: 1.8rem 0 0.4rem; padding-bottom: 0.25rem; border-bottom: 2px solid var(--sl-color-accent-low); }

  .ex-card { border: 1px solid var(--sl-color-hairline); border-left: 4px solid var(--sl-color-gray-5);
    border-radius: 10px; padding: 1rem 1.15rem; margin: 1rem 0; background: var(--sl-color-bg-nav); }
  .ex-card.is-done { border-left-color: var(--sa-olive, #8C9E38); }
  .ex-head { display: flex; align-items: flex-start; gap: 0.7rem; }
  .ex-n { flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center;
    background: var(--sl-color-accent-low); color: var(--sl-color-text-accent); font-weight: 700; font-size: 0.85rem; }
  .ex-title { margin: 0; font-size: 1rem; }
  .ex-tick { color: var(--sa-olive, #8C9E38); opacity: 0; margin-left: 0.25rem; }
  .ex-card.is-done .ex-tick { opacity: 1; }
  .ex-concept { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-3); font-weight: 600; }
  .ex-prompt { margin: 0.6rem 0; }
  .ex-prompt code, .ttl code { font-size: 0.9em; }

  textarea.q { width: 100%; font-family: var(--sl-font-mono, ui-monospace, monospace); font-size: 0.85rem;
    line-height: 1.5; padding: 0.7rem 0.8rem; border: 1px solid var(--sl-color-hairline); border-radius: 8px;
    background: var(--sl-color-bg); color: var(--sl-color-white); resize: vertical; tab-size: 2; }
  .ex-actions { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.6rem; flex-wrap: wrap; }
