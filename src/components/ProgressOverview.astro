---
// Training progress panel (used on the Training landing). Reads the training graph's
// per-category lesson routes and reflects the reader's localStorage completion state.
import { buildGraph, CATEGORY_ORDER } from '../lib/training-graph';

const g = buildGraph();
const cats = CATEGORY_ORDER.filter((c) => g.byCategory.has(c));
const data: Record<string, string[]> = Object.fromEntries(
  cats.map((c) => [c, g.byCategory.get(c) ?? []])
);
const total = Object.values(data).reduce((a, r) => a + r.length, 0);
---

<div class="progress-panel">
  <div class="pp-head">
    <span class="pp-title">Your progress</span>
    <span class="pp-count" id="pp-count">0 / {total} lessons</span>
  </div>
  <div class="pp-bar"><div class="pp-fill" id="pp-fill" style="width:0%"></div></div>
  <a class="pp-continue" id="pp-continue" href="#" hidden>Continue where you left off →</a>
  <div class="pp-cats">
    {cats.map((c) => (
      <div class="pp-cat" data-cat={c}>
        <div class="pp-cat-row"><span>{c}</span><span class="pp-cat-count">0/{data[c].length}</span></div>
        <div class="pp-cat-bar"><div class="pp-cat-fill" style="width:0%"></div></div>
      </div>
    ))}
  </div>
</div>

<script id="pp-data" type="application/json" set:html={JSON.stringify(data)}></script>
<script>
  (function () {
    const K = (r: string) => 'sat:done:' + r;
    const data = JSON.parse(document.getElementById('pp-data')!.textContent!);
    const done = (r: string) => localStorage.getItem(K(r)) === '1';
    function render() {
      let all = 0, allDone = 0;
      document.querySelectorAll<HTMLElement>('.pp-cat').forEach((el) => {
        const routes: string[] = data[el.dataset.cat!] || [];
        const d = routes.filter(done).length;
        all += routes.length; allDone += d;
        el.querySelector('.pp-cat-count')!.textContent = d + '/' + routes.length;
        (el.querySelector('.pp-cat-fill') as HTMLElement).style.width =
          (routes.length ? Math.round((100 * d) / routes.length) : 0) + '%';
      });
      document.getElementById('pp-count')!.textContent = allDone + ' / ' + all + ' lessons';
      (document.getElementById('pp-fill') as HTMLElement).style.width =
        (all ? Math.round((100 * allDone) / all) : 0) + '%';
    }
    function continueLink() {
      const el = document.getElementById('pp-continue') as HTMLAnchorElement;
      try {
        const last = JSON.parse(localStorage.getItem('sat:last') || 'null');
        if (last && last.route) {
          el.href = last.route;
          el.textContent = 'Continue: ' + (last.title || 'last lesson') + ' →';
          el.hidden = false;
        }
      } catch (e) { /* ignore */ }
    }
    render();
    continueLink();
    document.addEventListener('sat:progress', render);
    window.addEventListener('storage', render);
  })();
</script>
