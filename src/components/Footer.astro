---
// Global Footer override. On a Training lesson page it adds a "mark complete" control
// and a related-lessons list (both keyed on the page's route); on every other page the
// graph has no matching node, so it renders nothing but the default footer.
import Default from '@astrojs/starlight/components/Footer.astro';
import { buildGraph } from '../lib/training-graph';

const g = buildGraph();
const route = Astro.url.pathname;
const node = g.nodes.find((n) => n.id === route);
const related = (g.related.get(route) ?? []).slice(0, 8);
---

{node && (
  <div class="lesson-tools" data-route={route} data-title={node.title}>
    <button class="mark-done" data-route={route}>Mark complete</button>
    {related.length > 0 && (
      <nav class="related" aria-label="Related lessons">
        <p class="related-h">Related lessons</p>
        <ul>
          {/* ids are already full /training/… routes */}
          {related.map((r) => (
            <li><a href={r.id}>{r.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </div>
)}

<Default {...Astro.props} />

<script>
  (function () {
    const K = (r: string) => 'sat:done:' + r;
    function paint() {
      document.querySelectorAll<HTMLButtonElement>('.mark-done').forEach((b) => {
        const done = localStorage.getItem(K(b.dataset.route!)) === '1';
        b.classList.toggle('is-done', done);
        b.textContent = done ? 'Completed ✓' : 'Mark complete';
      });
      document.querySelectorAll<HTMLAnchorElement>('.sidebar a[href]').forEach((a) => {
        const href = a.getAttribute('href');
        if (href && localStorage.getItem(K(href)) === '1') a.classList.add('sat-done');
      });
    }
    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest?.('.mark-done') as HTMLButtonElement | null;
      if (!b) return;
      const k = K(b.dataset.route!);
      localStorage.setItem(k, localStorage.getItem(k) === '1' ? '0' : '1');
      paint();
      document.dispatchEvent(new Event('sat:progress'));
    });
    const tools = document.querySelector<HTMLElement>('.lesson-tools');
    if (tools?.dataset.route) {
      localStorage.setItem('sat:last', JSON.stringify({ route: tools.dataset.route, title: tools.dataset.title }));
    }
    paint();
  })();
</script>
