---
// Custom Starlight header: keeps the native (theme-aware) header chrome — wordmark, search,
// theme toggle — but adds a consistent cross-section nav so navigation is the same on every
// page (the home launcher carries the same links). Reuses Starlight's own Search + ThemeSelect
// so nothing is lost. The mobile sidebar toggle is rendered elsewhere by Starlight, untouched.
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import config from 'virtual:starlight/user-config';

const p = Astro.url.pathname;
const on = (x) => (p === x || p.startsWith(x) ? 'on' : '');
const showSearch = config.pagefind;

const SECTIONS = [
  ['/operations-manual/', 'Ops Manual'],
  ['/reference/', 'Reference'],
  ['/training/', 'Training'],
  ['/administrative/', 'Administrative'],
  ['/offerings/', 'Offerings'],
  ['/internal-systems/', 'Internal Systems'],
  ['/data-centric-architecture/', 'Data-Centric'],
];
---

<div class="sa-hdr">
  <div class="sa-hdr-title"><SiteTitle /></div>
  <nav class="sa-hdr-nav" aria-label="Sections">
    {SECTIONS.map(([href, label]) => (
      <a class={on(href)} href={href}>{label}</a>
    ))}
    {/* Access-gated: default-hidden via brand.css [data-gate]; identity-nav reveals for ops. */}
    <a class={on('/operations/')} href="/operations/" data-gate="/operations/">Operations</a>
  </nav>
  <div class="sa-hdr-tools">
    {showSearch && <Search />}
    <ThemeSelect />
  </div>
</div>

<style>
  .sa-hdr {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    min-width: 0;
  }
  .sa-hdr-title {
    flex: none;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }
  /* Section nav — takes the middle, scrolls horizontally rather than wrapping. */
  .sa-hdr-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sa-hdr-nav::-webkit-scrollbar { display: none; }
  .sa-hdr-nav a {
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    padding: 5px 10px;
    border-radius: 6px;
    line-height: 1.2;
  }
  .sa-hdr-nav a:hover { color: var(--sl-color-white); background: var(--sl-color-gray-6); }
  .sa-hdr-nav a.on { color: var(--sl-color-text-accent); background: var(--sl-color-accent-low); }
  .sa-hdr-tools {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  /* On narrow viewports the section nav would crowd search + theme — hide it there and let
     the sidebar / mobile menu carry section navigation. */
  @media (max-width: 72rem) {
    .sa-hdr-nav { display: none; }
  }
</style>
